---
import '@fontsource/fraunces/latin-500.css';
import '@fontsource/fraunces/latin-600.css';
import '@fontsource/fraunces/latin-500-italic.css';
import '@fontsource/bagel-fat-one/latin-400.css';
import '@fontsource/bagel-fat-one/latin-ext-400.css';
import '@fontsource/caveat/latin-700.css';
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import TrackEvents from '../components/TrackEvents.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { loadAreas } from '../lib/areas';
import { loadListings } from '../lib/listings';
import { loadGuides } from '../lib/guides';
import { loadPeople } from '../lib/people';
import { loadProductions } from '../lib/productions';
import { href, siteName } from '../lib/site';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  modified?: string;
  jsonLd?: unknown[];
  /** Page language. Spanish pages pass 'es'. */
  lang?: 'en' | 'es';
  /** Translations of this page, for hreflang links. Paths, e.g. { lang: 'es', path: '/es/guias/x' }. */
  alternates?: Array<{ lang: 'en' | 'es'; path: string }>;
}

const {
  title,
  description,
  ogType = 'website',
  image = '/og.png',
  imageAlt = 'Washington Heights Guide, a guide to the best spots in Washington Heights, NYC.',
  noindex = false,
  modified,
  jsonLd = [],
  lang = 'en',
  alternates = [],
} = Astro.props;

if (!Astro.site) {
  throw new Error('Set SITE, or site in astro.config.mjs, so canonical URLs and the sitemap have an origin.');
}

const pathname = Astro.url.pathname;
const canonicalPath =
  pathname === '/404' || pathname === '/404/' || pathname === '/404.html'
    ? '/404.html'
    : pathname.endsWith('/')
      ? pathname
      : `${pathname}/`;
const canonical = new URL(canonicalPath, Astro.site);
/** Where the language switch goes: this page's translation if there is one, otherwise the other language's home. */
const otherLang = lang === 'es' ? 'en' : 'es';
const switchPath = alternates.find((alt) => alt.lang === otherLang)?.path ?? (lang === 'es' ? '/' : '/es');
const ogImage = new URL(image, Astro.site);
const listings = await loadListings();
const areas = await loadAreas();
const people = await loadPeople();
const guides = await loadGuides();
const productions = await loadProductions();
const showingExamples =
  listings.some((entry) => entry.data.example) ||
  areas.some((entry) => entry.data.example) ||
  people.some((entry) => entry.data.example) ||
  guides.some((entry) => entry.data.example) ||
  productions.some((entry) => entry.data.example);
const indexable = !noindex && !import.meta.env.DEV && !__INCLUDE_EXAMPLES__;
const robots = indexable ? 'index, follow, max-image-preview:large' : 'noindex, follow';
---

<!doctype html>
<html lang={lang}>
  <head>
    <script async src="https://www.googletagmanager.com/gtm.js?id=GTM-KNCGSJ2J"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try {
        const stored = localStorage.getItem('theme');
        const theme = stored === 'light' || stored === 'dark' ? stored : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
      } catch {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
    <script is:inline>
      // Lazy images fade in once loaded. Registered before any <img> is parsed, so no load is missed.
      // Without this script, the .js class is never set and images show normally.
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        const settle = (event) => {
          if (event.target instanceof HTMLImageElement) event.target.classList.add('is-loaded');
        };
        document.addEventListener('load', settle, true);
        document.addEventListener('error', settle, true);
        document.addEventListener('DOMContentLoaded', () => {
          document.querySelectorAll('img').forEach((img) => {
            if (img.complete) img.classList.add('is-loaded');
          });
        });
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#f3ecdf" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={lang === 'es' ? 'es_US' : 'en_US'} />
    {
      alternates.length > 0 && (
        <>
          <link rel="alternate" hreflang={lang} href={canonical.href} />
          {alternates.map((alt) => (
            <link rel="alternate" hreflang={alt.lang} href={new URL(href(alt.path), Astro.site).href} />
          ))}
          <link
            rel="alternate"
            hreflang="x-default"
            href={lang === 'en' ? canonical.href : new URL(href(alternates.find((alt) => alt.lang === 'en')?.path ?? '/'), Astro.site).href}
          />
        </>
      )
    }
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {modified && <meta property="article:modified_time" content={modified} />}
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    {
      jsonLd.map((entry) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(entry).replace(/</g, '\\u003c')} />
      ))
    }
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    {
      showingExamples && (
        <div class="notice notice-example" role="note">
          <div class="wrap">
            <strong>Example content.</strong> Names that include EXAMPLE are placeholders, not real places, areas, or people. A production build leaves them out.
          </div>
        </div>
      )
    }
    <SiteHeader lang={lang} switchPath={switchPath} />
    <main id="main" tabindex="-1" data-pagefind-body>
      <slot />
    </main>
    <SiteFooter lang={lang} switchPath={switchPath} />
    <TrackEvents />
  </body>
</html>
