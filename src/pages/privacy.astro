---
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbJsonLd } from '../lib/jsonld';
import { absoluteUrl, correctionsEmail, formatDate, href, isoDate, pageTitle, siteName } from '../lib/site';

const effectiveDate = new Date('2026-11-11T00:00:00Z');

const description = `How ${siteName} handles newsletter subscriptions, Google Analytics, cookies, and contact messages.`;
const site = Astro.site;
if (!site) throw new Error('Missing site URL.');

const jsonLd = [
  breadcrumbJsonLd([
    { name: siteName, url: absoluteUrl(site, '/') },
    { name: 'Privacy', url: absoluteUrl(site, '/privacy') },
  ]),
];
---

<BaseLayout title={pageTitle('Privacy')} description={description} jsonLd={jsonLd}>
  <article class="wrap prose">
    <header class="page-head">
      <p class="kicker">Your information</p>
      <h1>Privacy</h1>
      <p class="lede">A short explanation of the information used to run this guide.</p>
      <p>
        Effective date: <time datetime={isoDate(effectiveDate)}>{formatDate(effectiveDate)}</time>
      </p>
    </header>

    <h2>Newsletter</h2>
    <p>
      If you subscribe, your email address is sent to Buttondown, which stores and processes it to manage
      your subscription and deliver the newsletter. You can unsubscribe using the link in any newsletter
      email. For help with your subscription or a request to remove your information, contact{' '}
      <a href={`mailto:${correctionsEmail}`}>{correctionsEmail}</a>.
    </p>

    <h2 id="analytics">Analytics and cookies</h2>
    <p>
      This site uses Google Analytics, loaded through Google Tag Manager, to count visits and see which
      pages people read. Google Analytics sets cookies in your browser and collects information such as
      the pages you view, how you arrived, how far you scroll, links you follow off the site, words you
      type into this site's search, whether you submitted the newsletter form, and general details about
      your device, browser, and approximate location. It does not give this site your name or email address.
    </p>
    <p>
      Google processes this information under its own policies. You can read
      <a href="https://policies.google.com/technologies/partner-sites" rel="noopener noreferrer" target="_blank">how Google uses information from sites that use its services</a>.
      To stop Google Analytics from collecting your visits on every site, install the
      <a href="https://tools.google.com/dlpage/gaoptout" rel="noopener noreferrer" target="_blank">Google Analytics opt-out browser add-on</a>.
      You can also block or delete cookies in your browser settings. The guide works without them.
    </p>
    <p>
      The site also stores your light or dark mode choice in your browser so the setting sticks. That
      choice stays on your device and is not sent anywhere.
    </p>

    <h2 id="partners">Affiliate and advertising partners</h2>
    <p>
      Some pages include labeled affiliate links (see <a href={`${href('/about')}#disclosure`}>affiliate links and sponsorships</a>).
      If you follow one, the partner’s site may set its own cookies to record the referral. If this site
      adds advertising partners, they may also set cookies. Any such partners will be named on this page
      when they are added, with a link to their own privacy policy.
    </p>
    <p>Current affiliate partners:</p>
    <ul>
      <li>
        Viator, for tour and ticket links on some guides. See
        <a href="https://www.viator.com/support/privacyPolicy" rel="noopener noreferrer" target="_blank">Viator’s privacy and cookies statement<span class="sr-only"> (opens in a new tab)</span></a>.
      </li>
    </ul>

    <h2>Contact</h2>
    <p>
      For privacy questions, email <a href={`mailto:${correctionsEmail}`}>{correctionsEmail}</a>.
    </p>
  </article>
</BaseLayout>
