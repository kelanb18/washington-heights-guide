---
import ListingEntry from '../components/ListingEntry.astro';
import PersonEntry from '../components/PersonEntry.astro';
import PlaceMap from '../components/PlaceMap.astro';
import PlacePhoto from '../components/PlacePhoto.astro';
import StoryCard from '../components/StoryCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { areaTree, loadAreas } from '../lib/areas';
import { listingCounts } from '../lib/catalog';
import { loadGuides } from '../lib/guides';
import { breadcrumbJsonLd, itemListJsonLd, websiteJsonLd } from '../lib/jsonld';
import { collectTags, loadListings } from '../lib/listings';
import { loadPeople } from '../lib/people';
import { pinsFor } from '../lib/pins';
import { loadProductions } from '../lib/productions';
import { coverForArea, coverForGuide } from '../lib/covers';
import { absoluteUrl, defaultDescription, href, siteName } from '../lib/site';
import { siteFrames } from '../lib/site-heroes';

const [feature, ...moreFrames] = siteFrames;

const listings = await loadListings();
const areas = await loadAreas();
const people = await loadPeople();
const productions = await loadProductions();
const guides = await loadGuides();
const pins = pinsFor(listings);
const recent = [...listings].sort((a, b) => b.data.lastVerified.getTime() - a.data.lastVerified.getTime()).slice(0, 4);
const openings = listings.filter((listing) => listing.data.tags.includes('new-opening'));
const roots = areaTree(areas);
const counts = listingCounts(areas, listings);
const picks = listings.filter((listing) => listing.data.pick);
const tags = collectTags(listings);
const site = Astro.site;

if (!site) {
  throw new Error('Missing site URL.');
}

const homeUrl = absoluteUrl(site, '/');
const featured = (picks.length > 0 ? picks : listings).map((listing) => ({
  name: listing.data.name,
  url: absoluteUrl(site, `/places/${listing.id}`),
}));

const jsonLd: unknown[] = [
  websiteJsonLd(homeUrl, defaultDescription),
  breadcrumbJsonLd([{ name: siteName, url: homeUrl }]),
];

if (featured.length > 0) {
  jsonLd.push(itemListJsonLd('Editor’s picks in Washington Heights', featured));
}

if (areas.length > 0) {
  jsonLd.push(
    itemListJsonLd(
      'Areas in Washington Heights',
      areas.map((area) => ({
        name: area.data.name,
        url: absoluteUrl(site, `/areas/${area.id}`),
      })),
    ),
  );
}

if (people.length > 0) {
  jsonLd.push(
    itemListJsonLd(
      'Notable residents and history in Washington Heights',
      people.map((person) => ({
        name: person.data.name,
        url: absoluteUrl(site, `/people/${person.id}`),
      })),
    ),
  );
}
---

<BaseLayout
  title="The Heights — Best spots in Washington Heights, NYC"
  description={defaultDescription}
  image={feature.picture.src}
  imageAlt={feature.picture.alt}
  jsonLd={jsonLd}
>
  <div class="wrap">
    <section class="hero hero-pub">
      <div>
        <p class="kicker">Washington Heights · West 155th to Dyckman</p>
        <h1>The neighborhood, edited.</h1>
        <p class="lede">
          A local guide to where to eat, what to walk to, and who made the hill what it is. Short lists. Checked details. Rankings that are not for sale.
        </p>
        <p class="hero-actions">
          <a class="button" href={href('/best')}>Best of</a>
          <a class="button button-ghost" href={href('/places')}>All places</a>
        </p>
      </div>
      <PlacePhoto picture={feature.picture} label={feature.label} href={href(feature.href)} feature />
      <ul class="hero-set">
        {
          moreFrames.map((frame) => (
            <li>
              <PlacePhoto picture={frame.picture} label={frame.label} href={href(frame.href)} />
            </li>
          ))
        }
      </ul>
    </section>

    <ul class="principles">
      <li>
        <strong>Checked</strong>
        Every listing carries the date its address and hours were last verified.
      </li>
      <li>
        <strong>Short on purpose</strong>
        This is not a copy of every open door on Broadway, St. Nicholas, or Amsterdam.
      </li>
      <li>
        <strong>Independent</strong>
        Sponsors are labeled. A verdict cannot be bought.
      </li>
    </ul>

    <section aria-labelledby="best-heading">
      <div class="section-head">
        <h2 id="best-heading">Best of</h2>
        <a href={href('/best')}>All guides</a>
      </div>
      {
        guides.length > 0 ? (
          <ul class="guide-grid">
            {guides.slice(0, 4).map((guide) => {
              const cover = coverForGuide(guide, listings, areas);
              return (
                <li>
                  <StoryCard
                    href={href(`/best/${guide.id}`)}
                    kicker={`${guide.data.picks.length} places`}
                    title={guide.data.title}
                    description={guide.data.description}
                    cover={cover?.picture}
                  />
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="empty">Guides show up here after a list has been checked. Nothing is ranked until then.</p>
        )
      }
    </section>

    <section aria-labelledby="neighborhood-heading">
      <div class="section-head">
        <h2 id="neighborhood-heading">Neighborhoods</h2>
        <a href={href('/areas')}>All areas</a>
      </div>
      {
        roots.length > 0 ? (
          <ul class="guide-grid">
            {roots.map((node) => (
              <li>
                <StoryCard
                  href={href(`/areas/${node.area.id}`)}
                  kicker={`${counts[node.area.id] ?? 0} places`}
                  title={node.area.data.name}
                  description={node.area.data.summary}
                  cover={coverForArea(node.area, areas, listings)}
                />
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">Neighborhood notes will be listed here.</p>
        )
      }
      {pins.length > 0 && <PlaceMap pins={pins} label="Places in Washington Heights" />}
    </section>

    <section aria-labelledby="openings-heading">
      <div class="section-head">
        <h2 id="openings-heading">New in the neighborhood</h2>
        <a href={href('/places')}>All places</a>
      </div>
      <p class="section-note">
        Businesses that just opened. A page we published recently is not a new business. A sale, a closing, or plans for a place will be noted here once there is a source to cite.
      </p>
      {
        openings.length > 0 ? (
          <ul class="entries">
            {openings.map((listing) => (
              <ListingEntry listing={listing} heading="h3" />
            ))}
          </ul>
        ) : (
          <p class="empty">No newly opened businesses are on the list yet.</p>
        )
      }
    </section>

    <section aria-labelledby="new-heading">
      <div class="section-head">
        <h2 id="new-heading">Recently checked</h2>
        <a href={href('/places')}>All places</a>
      </div>
      <p class="section-note">The latest dates an address and hours were verified. These are not new businesses.</p>
      {
        recent.length > 0 ? (
          <ul class="entries">
            {recent.map((listing) => (
              <ListingEntry listing={listing} heading="h3" />
            ))}
          </ul>
        ) : (
          <p class="empty">No places have been published yet.</p>
        )
      }
    </section>

    <section aria-labelledby="screen-heading">
      <div class="section-head">
        <h2 id="screen-heading">Filmed in the Heights</h2>
        <a href={href('/filmed-here')}>The screen list</a>
      </div>
      {
        productions.length > 0 ? (
          <ul class="guide-grid">
            {productions.slice(0, 3).map((production) => (
              <li>
                <a class="guide-card" href={href(`/filmed-here/${production.id}`)}>
                  <p class="kicker">{production.data.year}</p>
                  <h3>{production.data.title}</h3>
                  <p>{production.data.summary}</p>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">
            The production notes are still being written. The <a href={href('/filmed-here')}>film permit list</a> is already there.
          </p>
        )
      }
    </section>

    <section aria-labelledby="people-heading">
      <div class="section-head">
        <h2 id="people-heading">Notable residents & history</h2>
        <a href={href('/people')}>All notes</a>
      </div>
      {
        people.length > 0 ? (
          <ul class="entries">
            {people.slice(0, 4).map((person) => (
              <PersonEntry person={person} heading="h3" />
            ))}
          </ul>
        ) : (
          <p class="empty">Residents and historic notes will be listed here.</p>
        )
      }
    </section>

    {
      tags.length > 0 && (
        <section aria-labelledby="tags-heading">
          <div class="section-head">
            <h2 id="tags-heading">Tags</h2>
          </div>
          <p class="tag-line">
            {tags.map((tag, index) => (
              <>
                {index > 0 && <span aria-hidden="true"> · </span>}
                <a href={href(`/tags/${tag.slug}`)}>
                  {tag.label}
                  <span class="sr-only"> ({tag.listings.length})</span>
                </a>
              </>
            ))}
          </p>
        </section>
      )
    }
  </div>
</BaseLayout>
