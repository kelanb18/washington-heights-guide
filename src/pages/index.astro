---
import AttributedPhoto from '../components/AttributedPhoto.astro';
import EventRow from '../components/EventRow.astro';
import HidePastEvents from '../components/HidePastEvents.astro';
import { dayHeading, loadEvents } from '../lib/events';
import PlaceMap from '../components/PlaceMap.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { areaTree, loadAreas } from '../lib/areas';
import { coverForGuide } from '../lib/covers';
import { loadGuides } from '../lib/guides';
import { breadcrumbJsonLd, itemListJsonLd, websiteJsonLd } from '../lib/jsonld';
import { loadListings } from '../lib/listings';
import { pinsFor } from '../lib/pins';
import { reservePicture } from '../lib/pictures';
import { absoluteUrl, formatDate, href, isoDate, siteName } from '../lib/site';
import { homeFrames } from '../lib/site-heroes';

const feature = homeFrames[0];
const listings = await loadListings();
const areas = await loadAreas();
const guides = await loadGuides();
const pins = pinsFor(listings);
const roots = areaTree(areas);
const flatten = (nodes: typeof roots): (typeof roots)[number]['area'][] =>
  nodes.flatMap((node) => [node.area, ...flatten(node.children)]);
const neighborhoods = flatten(roots);

const usedPictures = new Set<string>();
reservePicture(feature.picture, usedPictures);

/** The four "here for a reason" guides, in this order, when they are published. */
const situations: Array<{ id: string; kicker: string }> = [
  { id: 'food-near-newyork-presbyterian-columbia-medical-center', kicker: 'Visiting the hospital' },
  { id: 'where-to-eat-before-a-show-at-united-palace', kicker: 'Going to a show' },
  { id: 'after-the-cloisters-walk-to-hudson-heights', kicker: 'After the museum' },
  { id: 'a-day-in-washington-heights-first-time-visitors', kicker: 'First time here' },
];
const situationCards = situations.flatMap(({ id, kicker }) => {
  const guide = guides.find((entry) => entry.id === id);
  if (!guide) return [];
  return [{ guide, kicker, cover: coverForGuide(guide, listings, areas, usedPictures)?.picture }];
});

const { oneOff } = await loadEvents();
const weekAhead = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString().slice(0, 10);
const thisWeek = oneOff.filter((event) => event.start.slice(0, 10) <= weekAhead).slice(0, 5);

const openings = listings.filter((listing) => listing.data.tags.includes('new-opening')).slice(0, 3);

const startHere = [
  { numeral: 'i.', label: 'Eat', note: 'Dominican plates, coffee, bakeries, late nights', path: '/category/restaurant' },
  { numeral: 'ii.', label: 'See', note: 'The Cloisters, hilltop parks, the High Bridge', path: '/category/landmark' },
  { numeral: 'iii.', label: 'Walk', note: 'Guides with routes that open in Google Maps', path: '/best' },
  { numeral: 'iv.', label: 'Near me', note: 'Closest first, and what’s open right now', path: '/near-me' },
];

const site = Astro.site;
if (!site) throw new Error('Missing site URL.');

const homeUrl = absoluteUrl(site, '/');
const description =
  'An independent, locally researched guide to Washington Heights, NYC: where to eat, what to see, and walking routes, with checked details, maps, and cited sources.';
const jsonLd: unknown[] = [websiteJsonLd(homeUrl, description), breadcrumbJsonLd([{ name: siteName, url: homeUrl }])];
if (guides.length > 0) {
  jsonLd.push(
    itemListJsonLd(
      'Guides to Washington Heights',
      guides.map((guide) => ({ name: guide.data.title, url: absoluteUrl(site, `/best/${guide.id}`) })),
    ),
  );
}
---

<BaseLayout
  title="Washington Heights Guide: Food, Places & Neighborhoods"
  description={description}
  image={feature.picture.src}
  imageAlt={feature.picture.alt}
  jsonLd={jsonLd}
>
  <div class="wrap front">
    <section class="front-intro">
      <p class="front-byline">By Kelan, who lives in Hudson Heights</p>
      <h1>Where to eat, what to see, and how to walk Washington Heights.</h1>
      <p class="front-dek">A short list of places I’d send a friend, each one checked and dated.</p>
    </section>

    <div class="front-hero">
      <AttributedPhoto picture={feature.picture} variant="hero" />
    </div>

    <nav class="front-index" aria-labelledby="start-here">
      <p class="front-label" id="start-here">Start here</p>
      <ol>
        {
          startHere.map((item) => (
            <li>
              <a href={href(item.path)}>
                <span class="front-numeral" aria-hidden="true">{item.numeral}</span>
                <span class="front-index-text">
                  <span class="front-index-word">{item.label}</span>
                  <span class="front-index-note">{item.note}</span>
                </span>
                <span class="front-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    {
      situationCards.length > 0 && (
        <section class="front-section" aria-labelledby="reasons-heading">
          <h2 id="reasons-heading" class="front-heading">Here for a reason?</h2>
          <p class="front-subhead">Short guides for the trips people actually make.</p>
          <ul class="front-rows">
            {situationCards.map(({ guide, kicker, cover }) => (
              <li>
                <a href={href(`/best/${guide.id}`)}>
                  {cover && <img src={cover.src} alt={cover.alt} loading="lazy" decoding="async" width="92" height="92" />}
                  <span>
                    <span class="front-kicker">{kicker}</span>
                    <span class="front-row-title">{guide.data.title}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <p class="front-more">
            <a href={href('/best')}>All {guides.length} guides</a>
          </p>
        </section>
      )
    }

    {
      thisWeek.length > 0 && (
        <section class="front-section" aria-labelledby="events-heading" data-events-scope>
          <h2 id="events-heading" class="front-heading">This week</h2>
          <p class="front-subhead">Free programs in the parks, and what’s on at local venues.</p>
          <ul class="event-list event-list-ruled">
            {thisWeek.map((event) => (
              <EventRow event={event} showDay dayLabel={dayHeading(event.start).split(',')[0]} compact />
            ))}
          </ul>
          <p class="front-more">
            <a href={href('/events')}>All events</a>
          </p>
          <HidePastEvents />
        </section>
      )
    }

    {
      openings.length > 0 && (
        <section class="front-section" aria-labelledby="new-heading">
          <h2 id="new-heading" class="front-rule-heading">New in the neighborhood</h2>
          <ul class="front-list">
            {openings.map((listing) => (
              <li>
                <a href={href(`/places/${listing.id}`)}>
                  <span class="front-kicker">
                    Checked <time datetime={isoDate(listing.data.lastVerified)}>{formatDate(listing.data.lastVerified)}</time>
                  </span>
                  <span class="front-row-title">{listing.data.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      pins.length > 0 && (
        <section class="front-section" aria-labelledby="map-heading">
          <h2 id="map-heading" class="front-rule-heading">Every place on one map</h2>
          <PlaceMap pins={pins} label="Places in Washington Heights" />
        </section>
      )
    }

    {
      neighborhoods.length > 0 && (
        <section class="front-section" aria-labelledby="areas-heading">
          <h2 id="areas-heading" class="front-rule-heading">The neighborhoods</h2>
          <p class="front-inline-links">
            {neighborhoods.map((area, index) => (
              <>
                {index > 0 && <span aria-hidden="true"> · </span>}
                <a href={href(`/areas/${area.id}`)}>{area.data.name}</a>
              </>
            ))}
          </p>
        </section>
      )
    }

    <section class="front-section" aria-labelledby="archive-heading">
      <h2 id="archive-heading" class="front-rule-heading">From the archive</h2>
      <ul class="front-list">
        <li>
          <a href={href('/people/fort-washington-battle-1776')}>
            <span class="front-kicker">History</span>
            <span class="front-row-title">Where Fort Washington fell in 1776</span>
          </a>
        </li>
        <li>
          <a href={href('/filmed-here')}>
            <span class="front-kicker">Filmed here</span>
            <span class="front-row-title">In the Heights, Malcolm X, Coogan’s Bluff and more</span>
          </a>
        </li>
        <li>
          <a href={href('/people')}>
            <span class="front-kicker">People</span>
            <span class="front-row-title">Residents, from Lou Gehrig to Lin-Manuel Miranda</span>
          </a>
        </li>
      </ul>
    </section>

    <section class="front-signoff">
      <p>
        I check every listing myself, and each page shows the date I last did. Sponsors are labeled, and verdicts are not
        for sale. <em>— Kelan</em>
      </p>
      <p class="front-more"><a href={href('/about')}>How this guide works</a></p>
    </section>
  </div>
</BaseLayout>
