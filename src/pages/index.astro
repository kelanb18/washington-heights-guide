---
import HidePastEvents from '../components/HidePastEvents.astro';
import PlaceMap from '../components/PlaceMap.astro';
import TodayUptown from '../components/TodayUptown.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { areaTree, loadAreas } from '../lib/areas';
import { coverForGuide } from '../lib/covers';
import { loadEvents, timeRange, withOffset } from '../lib/events';
import { loadGuides } from '../lib/guides';
import { breadcrumbJsonLd, itemListJsonLd, websiteJsonLd } from '../lib/jsonld';
import { loadListings } from '../lib/listings';
import { pinsFor } from '../lib/pins';
import { referenceId } from '../lib/refs';
import { absoluteUrl, href, siteName } from '../lib/site';

const listings = await loadListings();
const areas = await loadAreas();
const guides = await loadGuides();
const guideIds = new Set(guides.map((guide) => guide.id));
const pins = pinsFor(listings);
const roots = areaTree(areas);
const flatten = (nodes: typeof roots): (typeof roots)[number]['area'][] =>
  nodes.flatMap((node) => [node.area, ...flatten(node.children)]);
const neighborhoods = flatten(roots);

/** Topic shortcuts. Each points at a published guide; a topic whose guide is missing is left out. */
const topics = [
  { label: 'Dominican food', guide: 'best-dominican-restaurants-washington-heights', tone: 'tomato' },
  { label: 'Parks and views', guide: 'best-parks-and-views-washington-heights', tone: 'street' },
  { label: 'Coffee', guide: 'best-coffee-shops-washington-heights', tone: 'grape' },
  { label: 'History', guide: 'history-lovers-guide-washington-heights', tone: 'bridge' },
  { label: 'Late-night food', guide: 'best-late-night-food-washington-heights', tone: 'flag' },
  { label: 'Brunch', guide: 'best-brunch-washington-heights', tone: 'tomato' },
  { label: 'With kids', guide: 'best-spots-for-families-washington-heights', tone: 'street' },
  { label: 'Bakeries and desserts', guide: 'best-bakeries-and-desserts-washington-heights', tone: 'grape' },
  { label: 'Bars', guide: 'best-bars-and-nightlife-washington-heights', tone: 'bridge' },
].filter((topic) => guideIds.has(topic.guide));

const usedPictures = new Set<string>();
const listingIds = new Set(listings.map((listing) => listing.id));
const topicCards = topics.flatMap((topic) => {
  const guide = guides.find((entry) => entry.id === topic.guide);
  if (!guide) return [];
  const picks = guide.data.picks.filter((pick) => {
    const id = referenceId(pick.listing);
    return id !== undefined && listingIds.has(id);
  }).length;
  return [{ ...topic, guide, picks, cover: coverForGuide(guide, listings, areas, usedPictures)?.picture }];
});
const situations = [
  { id: 'food-near-newyork-presbyterian-columbia-medical-center', caption: 'Food near the hospital', note: 'Including a 24-hour option' },
  { id: 'where-to-eat-before-a-show-at-united-palace', caption: 'Dinner before a show', note: 'Near the United Palace' },
  { id: 'after-the-cloisters-walk-to-hudson-heights', caption: 'After the Cloisters', note: 'A walk down to coffee and books' },
  { id: 'a-day-in-washington-heights-first-time-visitors', caption: 'A first visit', note: 'A full day, mapped' },
];
const situationCards = situations.flatMap((item) => {
  const guide = guides.find((entry) => entry.id === item.id);
  if (!guide) return [];
  return [{ ...item, guide, cover: coverForGuide(guide, listings, areas, usedPictures)?.picture }];
});

const { oneOff } = await loadEvents();
const weekAhead = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString().slice(0, 10);
const thisWeek = oneOff.filter((event) => event.start.slice(0, 10) <= weekAhead).slice(0, 4);
const stubTones = ['tomato', 'grape', 'street', 'bridge'];
const weekday = new Intl.DateTimeFormat('en-US', { timeZone: 'UTC', weekday: 'short' });
const stubDay = (local: string) => {
  const [y, m, d] = local.slice(0, 10).split('-').map(Number);
  return { day: weekday.format(new Date(Date.UTC(y, m - 1, d))).toUpperCase(), date: String(d) };
};

const openings = listings.filter((listing) => listing.data.tags.includes('new-opening')).slice(0, 3);

const ticker = ['W 181st St', 'United Palace', 'The High Bridge', 'Plaza de las Americas', 'Morris-Jumel Mansion', 'Little Red Lighthouse', 'Fort Tryon Park', 'The Cloisters'];

const site = Astro.site;
if (!site) throw new Error('Missing site URL.');

const homeUrl = absoluteUrl(site, '/');
const description =
  'An independent, locally researched guide to Washington Heights, NYC: where to eat, what to see, and walking routes, with checked details, maps, and cited sources.';
const jsonLd: unknown[] = [websiteJsonLd(homeUrl, description), breadcrumbJsonLd([{ name: siteName, url: homeUrl }])];
if (guides.length > 0) {
  jsonLd.push(
    itemListJsonLd(
      'Guides to Washington Heights',
      guides.map((guide) => ({ name: guide.data.title, url: absoluteUrl(site, `/best/${guide.id}`) })),
    ),
  );
}
---

<BaseLayout
  title="Washington Heights Guide: Food, Places & Neighborhoods"
  description={description}
  image="/images/site/home/collage-og.jpg"
  imageAlt="Washington Heights, the neighborhood guide: a collage of Fort Tryon Park, the George Washington Bridge, a W 181 St sign, the Dominican flag, and plates of mangú."
  jsonLd={jsonLd}
>
  <div class="wrap home">
    <div class="home-collage" data-nosnippet>
      <img
        src="/images/site/home/collage-1774.webp"
        srcset="/images/site/home/collage-760.webp 760w, /images/site/home/collage-1100.webp 1100w, /images/site/home/collage-1774.webp 1774w"
        sizes="(min-width: 72rem) 72rem, 100vw"
        width="1774"
        height="887"
        fetchpriority="high"
        decoding="async"
        alt="Washington Heights, the neighborhood guide: a torn-paper collage of the Fort Tryon Park banner and tower, George Washington in a straw hat, the Dominican flag, a W 181 St street sign, the George Washington Bridge, hibiscus flowers, plates of mangú, and apartment buildings above the trees."
      />
      <span class="sticker sticker-yellow home-collage-sticker" aria-hidden="true">Written by a neighbor</span>
    </div>
  </div>

  <div class="ticker" aria-hidden="true" data-nosnippet>
    <div class="ticker-track">
      {[0, 1].map(() => ticker.map((word) => <span>✶ {word}</span>))}
    </div>
  </div>

  <div class="wrap home">
    <section class="home-intro">
      <h1>Where to go in Washington Heights</h1>
      <svg class="squiggle" aria-hidden="true" width="230" height="14" viewBox="0 0 210 14">
        <path d="M2 9 C 30 2, 50 13, 80 7 S 140 3, 170 8 S 200 6, 208 5" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"></path>
      </svg>
      <p class="home-dek">
        The places in Washington Heights we recommend to friends. Every page is checked and dated, and anything sponsored is labeled.
      </p>
    </section>

    <TodayUptown />

    <section class="home-block" aria-labelledby="topic-heading">
      <p class="label" id="topic-heading">Browse by topic</p>
      <ul class="topic-grid">
        {
          topicCards.map((topic, index) => (
            <li class:list={['topic-tile', `topic-tone-${topic.tone}`, { 'is-featured': index === 0, 'has-cover': topic.cover }]}>
              <a href={href(`/best/${topic.guide.id}`)}>
                {topic.cover && <img src={topic.cover.src} alt="" loading="lazy" decoding="async" />}
                <span class="topic-count">{topic.picks} picks</span>
                <span class="topic-arrow" aria-hidden="true">→</span>
                <span class="topic-label">{topic.label}</span>
                {index === 0 && <span class="topic-note">{topic.guide.data.description}</span>}
                <span class="sr-only">: {topic.guide.data.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <a class="open-rn" href={href('/near-me')}>
      <span>
        <span class="open-rn-title">What’s near you</span>
        <span class="open-rn-note">Places sorted by distance from where you are</span>
      </span>
      <span class="open-rn-arrow" aria-hidden="true">→</span>
    </a>

    {
      situationCards.length > 0 && (
        <section class="home-block" aria-labelledby="reasons-heading">
          <div class="home-head">
            <h2 id="reasons-heading" class="poster-heading">Guides for a plan</h2>
            <a href={href('/best')}>All {guides.length} guides</a>
          </div>
          <ul class="polaroids">
            {situationCards.map((card) => (
              <li>
                <a class="polaroid" href={href(`/best/${card.guide.id}`)}>
                  {card.cover && <img src={card.cover.src} alt={card.cover.alt} loading="lazy" decoding="async" />}
                  <span class="polaroid-caption">{card.caption}</span>
                  <span class="polaroid-note">{card.note}</span>
                  <span class="sr-only">: {card.guide.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      thisWeek.length > 0 && (
        <section class="home-block" aria-labelledby="events-heading" data-events-scope>
          <div class="home-head">
            <h2 id="events-heading" class="poster-heading">This week</h2>
            <a href={href('/events')}>All events</a>
          </div>
          <ul class="stubs">
            {thisWeek.map((event, index) => {
              const when = stubDay(event.start);
              return (
                <li class="stub" data-event-end={withOffset(event.end ?? event.start)}>
                  <p class:list={['stub-date', `tone-${stubTones[index % stubTones.length]}`]}>
                    <span>{when.day}</span>
                    <span class="stub-num">{when.date}</span>
                    <span>{timeRange(event.start, event.end)}</span>
                  </p>
                  <div class="stub-body">
                    <span class="mini-sticker">{event.label}</span>
                    <h3>
                      <a href={event.sourceUrl} rel="noopener noreferrer" target="_blank">
                        {event.title}
                        <span class="sr-only"> (opens {event.sourceName} in a new tab)</span>
                      </a>
                    </h3>
                    <p>
                      {event.listingId ? <a href={href(`/places/${event.listingId}`)}>{event.place}</a> : event.place}
                    </p>
                  </div>
                </li>
              );
            })}
          </ul>
          <p class="front-subhead" data-events-empty hidden>Nothing else this week. The events page has what’s next.</p>
          <a class="pill pill-ink" href={href('/events')}>See all events →</a>
          <HidePastEvents />
        </section>
      )
    }

    {
      openings.length > 0 && (
        <section class="home-block" aria-labelledby="new-heading">
          <h2 id="new-heading" class="poster-heading">New openings</h2>
          <ul class="home-list">
            {openings.map((listing) => (
              <li>
                <a href={href(`/places/${listing.id}`)}>
                  <span class="mini-sticker mini-sticker-yellow">New</span>
                  <span class="home-list-title">{listing.data.name}</span>
                  <span class="home-list-note">{listing.data.verdict}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      pins.length > 0 && (
        <section class="home-block" aria-labelledby="map-heading">
          <div class="home-head">
            <h2 id="map-heading" class="poster-heading">Map</h2>
            <a href={href('/map')}>Open the full map</a>
          </div>
          <PlaceMap pins={pins} label="Places in Washington Heights" />
        </section>
      )
    }

    {
      neighborhoods.length > 0 && (
        <section class="home-block" aria-labelledby="areas-heading">
          <h2 id="areas-heading" class="poster-heading">Neighborhoods</h2>
          <ul class="corners">
            {neighborhoods.map((area) => (
              <li>
                <a class="pill pill-plain pill-square" href={href(`/areas/${area.id}`)}>{area.data.name}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="home-block" aria-labelledby="archive-heading">
      <h2 id="archive-heading" class="poster-heading">History and film</h2>
      <ul class="home-list">
        <li>
          <a href={href('/people/fort-washington-battle-1776')}>
            <span class="mini-sticker">History</span>
            <span class="home-list-title">Where Fort Washington fell in 1776</span>
          </a>
        </li>
        <li>
          <a href={href('/filmed-here')}>
            <span class="mini-sticker">Filmed here</span>
            <span class="home-list-title">In the Heights, Malcolm X, Coogan’s Bluff and more</span>
          </a>
        </li>
        <li>
          <a href={href('/people')}>
            <span class="mini-sticker">People</span>
            <span class="home-list-title">Residents, from Lou Gehrig to Lin-Manuel Miranda</span>
          </a>
        </li>
      </ul>
    </section>

    <section class="promise">
      <p class="promise-title">No paid reviews</p>
      <p>We check every spot in person and date every page. Sponsors get a label, never a better review.</p>
      <p class="promise-link"><a href={href('/about')}>How this guide works</a></p>
    </section>
  </div>
</BaseLayout>
