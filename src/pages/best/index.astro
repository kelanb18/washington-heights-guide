---
import StoryCard from '../../components/StoryCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadAreas } from '../../lib/areas';
import { coverForGuide } from '../../lib/covers';
import { loadGuides } from '../../lib/guides';
import { breadcrumbJsonLd, itemListJsonLd } from '../../lib/jsonld';
import { loadListings } from '../../lib/listings';
import { absoluteUrl, formatDate, href, siteName } from '../../lib/site';

const guides = await loadGuides();
const listings = await loadListings();
const areas = await loadAreas();
const usedCoverSources = new Set<string>();
const guideCards = guides.map((guide) => ({
  guide,
  cover: coverForGuide(guide, listings, areas, usedCoverSources),
}));
const description = 'Checked lists of where to eat, drink, and go in Washington Heights. Rankings are editorial. They are not paid placements.';
const site = Astro.site;
if (!site) throw new Error('Missing site URL.');
const pageUrl = absoluteUrl(site, '/best');
const jsonLd: unknown[] = [
  breadcrumbJsonLd([
    { name: siteName, url: absoluteUrl(site, '/') },
    { name: 'Best of', url: pageUrl },
  ]),
];
if (guides.length > 0) {
  jsonLd.push(
    itemListJsonLd(
      'Best of Washington Heights',
      guides.map((guide) => ({ name: guide.data.title, url: absoluteUrl(site, `/best/${guide.id}`) })),
    ),
  );
}
---

<BaseLayout title={`Best of Washington Heights · ${siteName}`} description={description} jsonLd={jsonLd}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={href('/')}>Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Best of</span>
    </nav>
    <header class="page-head">
      <p class="kicker">Guides</p>
      <h1>Best of the Heights</h1>
      <p class="lede">Short lists with a point of view. A badge means an editor’s call, not a payment.</p>
    </header>
    {
      guides.length === 0 ? (
        <p class="empty">No guides have been published yet. When a list has been checked, it will show up here.</p>
      ) : (
        <ul class="guide-grid">
          {guideCards.map(({ guide, cover }) => (
              <li>
                <StoryCard
                  href={href(`/best/${guide.id}`)}
                  heading="h2"
                  kicker={`${guide.data.picks.length} ${guide.data.picks.length === 1 ? 'place' : 'places'}`}
                  title={guide.data.title}
                  description={guide.data.description}
                  cover={cover?.picture}
                  meta={`Updated ${formatDate(guide.data.updated)}`}
                />
              </li>
            ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
