---
import { render } from 'astro:content';
import AttributedPhoto from '../../components/AttributedPhoto.astro';
import PhotoSet from '../../components/PhotoSet.astro';
import PlaceMap from '../../components/PlaceMap.astro';
import SourceList from '../../components/SourceList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadAreas } from '../../lib/areas';
import { coverForGuide } from '../../lib/covers';
import { findArea } from '../../lib/catalog';
import { loadGuides, loadSpanishGuides } from '../../lib/guides';
import { breadcrumbJsonLd, itemListJsonLd } from '../../lib/jsonld';
import { loadListings } from '../../lib/listings';
import { directionsHref, northToSouth, walkingRoute } from '../../lib/directions';
import { pinsFor } from '../../lib/pins';
import { claimFirstPicture, reservePicture } from '../../lib/pictures';
import { referenceId } from '../../lib/refs';
import { absoluteUrl, formatDate, href, isoDate, mapsHref, pageTitleFit, siteName } from '../../lib/site';
import { categoryInfo, isCategory } from '../../lib/taxonomy';

export async function getStaticPaths() {
  const guides = await loadGuides();
  return guides.map((guide) => ({ params: { slug: guide.id } }));
}

const guides = await loadGuides();
const guide = guides.find((entry) => entry.id === Astro.params.slug);
if (!guide) throw new Error(`[guides] No public guide for "${Astro.params.slug}".`);

const listings = await loadListings();
// Entries cached before `stays` existed can lack the field, so fall back to none.
const stays = guide.data.stays ?? [];
const ranked = guide.data.picks.flatMap((pick, index) => {
  const id = referenceId(pick.listing);
  const listing = listings.find((entry) => entry.id === id);
  return listing ? [{ pick, listing, rank: index + 1 }] : [];
});
const areas = await loadAreas();
const area = findArea(areas, guide.data.area);
const category = guide.data.category && isCategory(guide.data.category) ? categoryInfo[guide.data.category] : undefined;
const related = guides
  .filter((entry) => entry.id !== guide.id)
  .filter((entry) => {
    if (guide.data.area && referenceId(entry.data.area) === referenceId(guide.data.area)) return true;
    if (guide.data.category && entry.data.category === guide.data.category) return true;
    return false;
  })
  .slice(0, 3);
const hero =
  guide.data.image ?? coverForGuide(guide, listings, areas)?.picture;
const usedPictures = new Set<string>();
if (hero) reservePicture(hero, usedPictures);
const rankedCards = ranked.map((item) => ({
  ...item,
  photo:
    claimFirstPicture(
      [...(item.listing.data.image ? [item.listing.data.image] : []), ...item.listing.data.gallery],
      usedPictures,
    ) ?? null,
}));
const spanish = (await loadSpanishGuides()).find((pair) => pair.guide.id === guide.id);
const routeStops =
  guide.data.route === 'as-listed'
    ? ranked.map((item) => item.listing)
    : northToSouth(
        ranked.map((item) => item.listing),
        listings,
      );
const routeLegs = walkingRoute(routeStops);
const { Content } = await render(guide);
const site = Astro.site;
if (!site) throw new Error('Missing site URL.');
const pageUrl = absoluteUrl(site, `/best/${guide.id}`);
const jsonLd = [
  itemListJsonLd(
    guide.data.title,
    [
      ...ranked.map((item) => ({
        name: item.listing.data.name,
        url: absoluteUrl(site, `/places/${item.listing.id}`),
      })),
      ...stays.map((stay) => ({ name: stay.name, url: stay.website })),
    ],
  ),
  breadcrumbJsonLd([
    { name: siteName, url: absoluteUrl(site, '/') },
    { name: 'Best of', url: absoluteUrl(site, '/best') },
    { name: guide.data.title, url: pageUrl },
  ]),
];
---

<BaseLayout
  title={pageTitleFit(guide.data.title)}
  description={guide.data.description}
  ogType="article"
  image={hero?.src}
  imageAlt={hero?.alt}
  modified={isoDate(guide.data.updated)}
  noindex={guide.data.example || guide.data.draft}
  jsonLd={jsonLd}
  alternates={spanish ? [{ lang: 'es', path: `/es/guias/${guide.id}` }] : []}
>
  <article class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={href('/')}>Home</a>
      <span aria-hidden="true">/</span>
      <a href={href('/best')}>Best of</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{guide.data.title}</span>
    </nav>
    <header class="page-head">
      <p class="kicker">
        Best of
        {category && (
          <>
            <span aria-hidden="true"> · </span>
            <a href={href(`/category/${guide.data.category}`)}>{category.plural}</a>
          </>
        )}
        {area && (
          <>
            <span aria-hidden="true"> · </span>
            <a href={href(`/areas/${area.id}`)}>{area.data.name}</a>
          </>
        )}
        {spanish && (
          <>
            <span aria-hidden="true"> · </span>
            <a href={href(`/es/guias/${guide.id}`)} hreflang="es" lang="es">Leer en español</a>
          </>
        )}
      </p>
      <h1>{guide.data.title}</h1>
      <p class="lede">{guide.data.description}</p>
      <p class="where">
        Updated <time datetime={isoDate(guide.data.updated)}>{formatDate(guide.data.updated)}</time>
      </p>
      {guide.data.affiliateDisclosure && (
        <p class="where">Some links on this page may earn us a commission if you book, at no extra cost to you.</p>
      )}
      {guide.data.example &&<p class="example-line">Example guide. Not a real ranking. Omitted from the production build.</p>}
    </header>
    <PhotoSet image={hero} />
    <div class="prose">
      <Content />
    </div>
    {
      routeStops.length > 1 && (
        <section class="route-box" aria-labelledby="route-heading">
          <h2 id="route-heading">Walk this list</h2>
          <p class="route-note">
            Opens Google Maps with walking directions from where you are
            {guide.data.route === 'as-listed' ? ', in the order above' : ', ordered north to south so you do not double back'}.
            {routeLegs.length > 1 &&
              ` Google Maps on a phone takes four stops per link, so the walk comes in ${routeLegs.length} parts. Each part starts where the last one ended.`}
          </p>
          <ol class="route-stops">
            {routeStops.map((listing) => (
              <li>{listing.data.name}</li>
            ))}
          </ol>
          <p class="action-row">
            {routeLegs.map((leg, index) => (
              <a class:list={['button', { 'button-ghost': index > 0 }]} href={leg.href} rel="noopener noreferrer" target="_blank">
                {routeLegs.length === 1
                  ? 'Open the route in Google Maps'
                  : `Part ${index + 1}: stops ${leg.from}–${leg.to}`}
                <span class="sr-only"> (opens Google Maps in a new tab)</span>
              </a>
            ))}
          </p>
        </section>
      )
    }
    <ol class="ranked">
      {rankedCards.map((item) => (
        <li class="ranked-card">
          <p class="entry-index">{String(item.rank).padStart(2, '0')}</p>
          {item.photo && <AttributedPhoto picture={item.photo} variant="thumb" />}
          <div>
            {item.pick.badge && <p class="badge">{item.pick.badge}</p>}
            {item.listing.data.sponsored && <p class="sponsored-flag">Sponsored</p>}
            <p class="kicker">
              <a class="chip" href={href(`/category/${item.listing.data.category}`)}>
                {categoryInfo[item.listing.data.category].singular}
              </a>
            </p>
            <h2 class="entry-title">
              <a href={href(`/places/${item.listing.id}`)}>{item.listing.data.name}</a>
            </h2>
            <p class="pick-blurb">{item.pick.blurb}</p>
            {item.pick.affiliate && (
              <p class="pick-blurb">
                <a href={item.pick.affiliate.href} rel="sponsored noopener noreferrer" target="_blank">
                  {item.pick.affiliate.label}<span class="sr-only"> (opens in a new tab)</span>
                </a>
              </p>
            )}
            <p class="where">
              {item.listing.data.crossStreets}
              <span aria-hidden="true"> · </span>
              <a href={directionsHref(item.listing)} rel="noopener noreferrer" target="_blank">
                Directions<span class="sr-only"> to {item.listing.data.name} (opens Google Maps)</span>
              </a>
            </p>
          </div>
        </li>
      ))}
    </ol>
    {
      stays.length > 0 && (
        <ol class="ranked" start={ranked.length + 1}>
          {stays.map((stay, index) => (
            <li class="ranked-card">
              <p class="entry-index">{String(ranked.length + index + 1).padStart(2, '0')}</p>
              <div>
                {stay.badge && <p class="badge">{stay.badge}</p>}
                <p class="kicker">
                  <span class="chip">{stay.nearby ? `Nearby · ${stay.neighborhood}` : stay.neighborhood}</span>
                </p>
                <h2 class="entry-title">
                  <a href={stay.website} rel="noopener noreferrer" target="_blank">
                    {stay.name}<span class="sr-only"> (opens the official site in a new tab)</span>
                  </a>
                </h2>
                <p class="pick-blurb">{stay.blurb}</p>
                {stay.linkPlaceholder && <p class="pick-blurb">{stay.linkPlaceholder}</p>}
                <p class="where">
                  {stay.address}
                  <span aria-hidden="true"> · </span>
                  <a href={mapsHref([stay.name, stay.address])} rel="noopener noreferrer" target="_blank">
                    Directions<span class="sr-only"> to {stay.name} (opens Google Maps)</span>
                  </a>
                </p>
              </div>
            </li>
          ))}
        </ol>
      )
    }
    {ranked.length > 0 && <PlaceMap pins={pinsFor(ranked.map((item) => item.listing))} label={`Map for ${guide.data.title}`} />}
    {
      guide.data.sources.length > 0 && (
        <section class="group" aria-labelledby="guide-sources">
          <div class="section-head">
            <h2 id="guide-sources">Sources</h2>
          </div>
          <SourceList urls={guide.data.sources} />
        </section>
      )
    }
    {
      related.length > 0 && (
        <section class="group" aria-labelledby="related-guides">
          <div class="section-head">
            <h2 id="related-guides">Related guides</h2>
          </div>
          <ul class="tag-line">
            {related.map((entry, index) => (
              <li>
                {index > 0 && <span aria-hidden="true"> · </span>}
                <a href={href(`/best/${entry.id}`)}>{entry.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>
