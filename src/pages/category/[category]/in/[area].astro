---
import ListingEntry from '../../../../components/ListingEntry.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { descendantIds, loadAreas } from '../../../../lib/areas';
import { listingsInArea } from '../../../../lib/catalog';
import { breadcrumbJsonLd, itemListJsonLd } from '../../../../lib/jsonld';
import { loadListings } from '../../../../lib/listings';
import { absoluteUrl, href, siteName } from '../../../../lib/site';
import { categories, categoryInfo, isCategory } from '../../../../lib/taxonomy';

export async function getStaticPaths() {
  const areas = await loadAreas();
  const listings = await loadListings();
  const paths = [];
  for (const category of categories) {
    for (const area of areas) {
      const count = listingsInArea(area.id, areas, listings).filter((listing) => listing.data.category === category).length;
      if (count >= 2) paths.push({ params: { category, area: area.id } });
    }
  }
  return paths;
}

const categoryParam = Astro.params.category ?? '';
const areaId = Astro.params.area ?? '';
if (!isCategory(categoryParam)) {
  throw new Error(`[listings] Unknown category "${categoryParam}".`);
}

const areas = await loadAreas();
const area = areas.find((entry) => entry.id === areaId);
if (!area) throw new Error(`[areas] No public area for "${areaId}".`);

const info = categoryInfo[categoryParam];
const listings = listingsInArea(area.id, areas, await loadListings())
  .filter((listing) => listing.data.category === categoryParam)
  .sort((a, b) => a.data.name.localeCompare(b.data.name, 'en'));

if (listings.length < 2 || !descendantIds(area.id, areas).has(area.id)) {
  throw new Error(`[listings] ${info.plural} in ${area.data.name} does not have enough places to publish.`);
}

const description = `${info.plural} in ${area.data.name}, listed alphabetically. This page is not a ranking.`;
const site = Astro.site;
if (!site) throw new Error('Missing site URL.');

const pageUrl = absoluteUrl(site, `/category/${categoryParam}/in/${area.id}`);
const jsonLd = [
  breadcrumbJsonLd([
    { name: siteName, url: absoluteUrl(site, '/') },
    { name: info.plural, url: absoluteUrl(site, `/category/${categoryParam}`) },
    { name: area.data.name, url: pageUrl },
  ]),
  itemListJsonLd(
    `${info.plural} in ${area.data.name}`,
    listings.map((listing) => ({
      name: listing.data.name,
      url: absoluteUrl(site, `/places/${listing.id}`),
    })),
  ),
];
---

<BaseLayout title={`${info.plural} in ${area.data.name} · ${siteName}`} description={description} jsonLd={jsonLd}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={href('/')}>Home</a>
      <span aria-hidden="true">/</span>
      <a href={href(`/category/${categoryParam}`)}>{info.plural}</a>
      <span aria-hidden="true">/</span>
      <a href={href(`/areas/${area.id}`)}>{area.data.name}</a>
    </nav>
    <header class="page-head">
      <p class="kicker">In the neighborhood</p>
      <h1>{info.plural} in {area.data.name}</h1>
      <p class="lede">Alphabetical, not a ranking. Smaller sections of {area.data.name} are included.</p>
      <p class="count">{listings.length} places</p>
    </header>
    <ul class="entries">
      {listings.map((listing) => (
        <ListingEntry listing={listing} />
      ))}
    </ul>
  </div>
</BaseLayout>
