---
import { render } from 'astro:content';
import ListingEntry from '../../components/ListingEntry.astro';
import PersonEntry from '../../components/PersonEntry.astro';
import PhotoSet from '../../components/PhotoSet.astro';
import PlaceMap from '../../components/PlaceMap.astro';
import ProductionEntry from '../../components/ProductionEntry.astro';
import SourceList from '../../components/SourceList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadSpanishAreas } from '../../lib/barrios';
import { ancestorAreas, areaTree, descendantIds, findAreaNode, loadAreas } from '../../lib/areas';
import { listingsInArea, peopleInArea } from '../../lib/catalog';
import { areaJsonLd, breadcrumbJsonLd, itemListJsonLd } from '../../lib/jsonld';
import { loadGuides } from '../../lib/guides';
import { loadListings } from '../../lib/listings';
import { loadPeople } from '../../lib/people';
import { pinsFor } from '../../lib/pins';
import { loadProductions } from '../../lib/productions';
import { coverForListing } from '../../lib/covers';
import { referenceId } from '../../lib/refs';
import { claimFirstPicture, reservePicture, shareableSrc } from '../../lib/pictures';
import { absoluteUrl, href, latestDate, pageTitle, siteName } from '../../lib/site';

export async function getStaticPaths() {
  const areas = await loadAreas();
  return areas.map((area) => ({
    params: { slug: area.id },
  }));
}

const areas = await loadAreas();
const area = areas.find((entry) => entry.id === Astro.params.slug);
if (!area) {
  throw new Error(`[areas] No public area for slug "${Astro.params.slug}".`);
}

const listings = listingsInArea(area.id, areas, await loadListings());
const people = peopleInArea(area.id, areas, await loadPeople());
const areaHero = area.data.image ?? area.data.gallery[0];
const areaGallery = area.data.image ? area.data.gallery : area.data.gallery.slice(1);
const areaIds = descendantIds(area.id, areas);
const productions = (await loadProductions()).filter((production) => {
  const id = referenceId(production.data.area);
  return id != null && areaIds.has(id);
});
const listingIds = new Set(listings.map((listing) => listing.id));
const guidesHere = (await loadGuides()).filter((guide) => {
  const guideArea = referenceId(guide.data.area);
  if (guideArea && areaIds.has(guideArea)) return true;
  return guide.data.picks.some((pick) => {
    const id = referenceId(pick.listing);
    return id != null && listingIds.has(id);
  });
});
const pins = pinsFor(listings);
const children = findAreaNode(areaTree(areas), area.id)?.children ?? [];
const ancestors = ancestorAreas(area, areas);
const directListings = listings.filter((listing) => referenceId(listing.data.area) === area.id).length;
const nestedListings = listings.length - directListings;
const directPeople = people.filter((person) => referenceId(person.data.area) === area.id).length;
const nestedPeople = people.length - directPeople;
const { Content } = await render(area);
const hasSpanish = (await loadSpanishAreas()).has(area.id);
const data = area.data;

const site = Astro.site;
if (!site) throw new Error('Missing site URL.');

const usedPictures = new Set<string>();
if (areaHero) reservePicture(areaHero, usedPictures);
for (const picture of areaGallery) reservePicture(picture, usedPictures);
const listingPhotos = new Map(
  listings.map((listing) => [listing.id, coverForListing(listing, usedPictures) ?? null]),
);
const personPhotos = new Map(
  people.map((person) => [
    person.id,
    claimFirstPicture(
      [...(person.data.image ? [person.data.image] : []), ...person.data.gallery],
      usedPictures,
    ) ?? null,
  ]),
);
const productionPhotos = new Map(
  productions.map((production) => [
    production.id,
    claimFirstPicture(production.data.image ? [production.data.image] : [], usedPictures) ?? null,
  ]),
);

const pageUrl = absoluteUrl(site, `/areas/${area.id}`);
const parent = ancestors.at(-1);
const crumbs = [
  { name: siteName, url: absoluteUrl(site, '/') },
  { name: 'Areas', url: absoluteUrl(site, '/areas') },
  ...ancestors.map((entry) => ({
    name: entry.data.name,
    url: absoluteUrl(site, `/areas/${entry.id}`),
  })),
  { name: data.name, url: pageUrl },
];

const jsonLd: unknown[] = [
  areaJsonLd(
    area,
    pageUrl,
    parent ? { name: parent.data.name, url: absoluteUrl(site, `/areas/${parent.id}`) } : undefined,
  ),
  breadcrumbJsonLd(crumbs),
];

if (children.length > 0) {
  jsonLd.push(
    itemListJsonLd(
      `Smaller sections of ${data.name}`,
      children.map((node) => ({
        name: node.area.data.name,
        url: absoluteUrl(site, `/areas/${node.area.id}`),
      })),
    ),
  );
}

if (listings.length > 0) {
  jsonLd.push(
    itemListJsonLd(
      `Places in ${data.name}`,
      listings.map((listing) => ({
        name: listing.data.name,
        url: absoluteUrl(site, `/places/${listing.id}`),
      })),
    ),
  );
}

if (people.length > 0) {
  jsonLd.push(
    itemListJsonLd(
      `People and events in ${data.name}`,
      people.map((person) => ({
        name: person.data.name,
        url: absoluteUrl(site, `/people/${person.id}`),
      })),
    ),
  );
}
---

<BaseLayout
  title={pageTitle(`${data.name}: Where to Eat & What to See`)}
  modified={latestDate(listings.map((listing) => listing.data.lastVerified))}
  description={data.summary}
  ogType="article"
  image={shareableSrc(areaHero?.src)}
  imageAlt={areaHero?.alt}
  noindex={data.example || data.draft}
  jsonLd={jsonLd}
  alternates={hasSpanish ? [{ lang: 'es', path: `/es/barrios/${area.id}` }] : []}
>
  <article class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={href('/')}>Home</a>
      <span aria-hidden="true">/</span>
      <a href={href('/areas')}>Areas</a>
      {
        ancestors.map((entry) => (
          <>
            <span aria-hidden="true">/</span>
            <a href={href(`/areas/${entry.id}`)}>{entry.data.name}</a>
          </>
        ))
      }
      <span aria-hidden="true">/</span>
      <span aria-current="page">{data.name}</span>
    </nav>

    <header class="listing-head">
      <p class="kicker">
        <a href={href('/areas')}>Area</a>
        {
          parent && (
            <>
              <span aria-hidden="true"> · </span>
              <a href={href(`/areas/${parent.id}`)}>{parent.data.name}</a>
            </>
          )
        }
        {
          hasSpanish && (
            <>
              <span aria-hidden="true"> · </span>
              <a href={href(`/es/barrios/${area.id}`)} hreflang="es" lang="es">En español</a>
            </>
          )
        }
      </p>
      <h1>{data.name}</h1>
      <p class="deck">{data.summary}</p>
      <p class="where">{data.boundaries}</p>
      {data.example && <p class="example-line">Example area. Not a real section. Omitted from the production build.</p>}
      {data.draft && !data.example && <p class="example-line">Draft. Visible in local development only.</p>}
    </header>

    <PhotoSet image={areaHero} gallery={areaGallery} />

    {
      pins.length > 0 && (
        <section class="group" aria-labelledby="map-heading">
          <div class="section-head">
            <h2 id="map-heading">Map</h2>
          </div>
          <PlaceMap pins={pins} label={`Places in ${data.name}`} />
        </section>
      )
    }

    <div class="listing-grid">
      <div>
        <div class="prose dropcap">
          <Content />
        </div>
      </div>

      <aside class="facts" aria-labelledby="facts-heading">
        <h2 id="facts-heading">Details</h2>
        <dl>
          {
            parent && (
              <>
                <dt>Part of</dt>
                <dd><a href={href(`/areas/${parent.id}`)}>{parent.data.name}</a></dd>
              </>
            )
          }
          <dt>Approximate streets</dt>
          <dd>{data.boundaries}</dd>
          <dt>Sources</dt>
          <dd><SourceList urls={data.sources} /></dd>
        </dl>
      </aside>
    </div>

    <section class="group" aria-labelledby="children-heading">
      <div class="section-head">
        <h2 id="children-heading">Smaller sections</h2>
        <span class="count">{children.length}</span>
      </div>
      {
        children.length > 0 ? (
          <ul class="contents">
            {children.map((node) => (
              <li>
                <a href={href(`/areas/${node.area.id}`)}>
                  <span class="contents-name">{node.area.data.name}</span>
                  <span class="contents-blurb">{node.area.data.summary}</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">No smaller sections are filed here yet.</p>
        )
      }
    </section>

    <section class="group" aria-labelledby="places-heading">
      <div class="section-head">
        <h2 id="places-heading">Places</h2>
        <a href={href('/places')}>All places</a>
      </div>
      {
        nestedListings > 0 && (
          <p class="section-note">
            Includes {nestedListings} {nestedListings === 1 ? 'place' : 'places'} filed under a smaller section.
          </p>
        )
      }
      {
        listings.length > 0 ? (
          <ul class="entries">
            {listings.map((listing) => (
              <ListingEntry listing={listing} photo={listingPhotos.get(listing.id)} heading="h3" />
            ))}
          </ul>
        ) : (
          <p class="empty">No published places are filed under this area yet.</p>
        )
      }
    </section>

    <section class="group" aria-labelledby="people-heading">
      <div class="section-head">
        <h2 id="people-heading">People and events</h2>
        <a href={href('/people')}>All notes</a>
      </div>
      {
        nestedPeople > 0 && (
          <p class="section-note">
            Includes {nestedPeople} {nestedPeople === 1 ? 'note' : 'notes'} filed under a smaller section.
          </p>
        )
      }
      {
        people.length > 0 ? (
          <ul class="entries">
            {people.map((person) => (
              <PersonEntry person={person} photo={personPhotos.get(person.id)} heading="h3" />
            ))}
          </ul>
        ) : (
          <p class="empty">No published people or events are filed under this area yet.</p>
        )
      }
    </section>

    {
      guidesHere.length > 0 && (
        <section class="group" aria-labelledby="guides-heading">
          <div class="section-head">
            <h2 id="guides-heading">Best of</h2>
            <a href={href('/best')}>All guides</a>
          </div>
          <ul class="tag-line">
            {guidesHere.map((guide) => (
              <li>
                <a href={href(`/best/${guide.id}`)}>{guide.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="group" aria-labelledby="filmed-heading">
      <div class="section-head">
        <h2 id="filmed-heading">Filmed here</h2>
        <a href={href('/filmed-here')}>All productions</a>
      </div>
      {
        productions.length > 0 ? (
          <ul class="entries">
            {productions.map((production) => (
              <ProductionEntry
                production={production}
                photo={productionPhotos.get(production.id)}
                heading="h3"
              />
            ))}
          </ul>
        ) : (
          <p class="empty">No published films or videos are filed under this area yet.</p>
        )
      }
    </section>
  </article>
</BaseLayout>
