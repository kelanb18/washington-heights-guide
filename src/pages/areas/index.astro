---
import AreaTree from '../../components/AreaTree.astro';
import AttributedPhoto from '../../components/AttributedPhoto.astro';
import PlaceMap from '../../components/PlaceMap.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { areasHero } from '../../lib/site-heroes';
import { areaTree, hasNestedAreas, loadAreas } from '../../lib/areas';
import { listingCounts } from '../../lib/catalog';
import { breadcrumbJsonLd, itemListJsonLd } from '../../lib/jsonld';
import { loadListings } from '../../lib/listings';
import { pinsFor } from '../../lib/pins';
import { absoluteUrl, href, pageTitle, siteName } from '../../lib/site';

const areas = await loadAreas();
const listings = await loadListings();
const pins = pinsFor(listings);
const tree = areaTree(areas);
const counts = listingCounts(areas, listings);
const nested = hasNestedAreas(tree);
const description =
  'Smaller sections of Washington Heights, listed on their own and nested when one sits inside another.';

const site = Astro.site;
if (!site) throw new Error('Missing site URL.');

const pageUrl = absoluteUrl(site, '/areas');
const jsonLd: unknown[] = [
  breadcrumbJsonLd([
    { name: siteName, url: absoluteUrl(site, '/') },
    { name: 'Areas', url: pageUrl },
  ]),
];

if (areas.length > 0) {
  jsonLd.push(
    itemListJsonLd(
      'Areas in Washington Heights',
      areas.map((area) => ({
        name: area.data.name,
        url: absoluteUrl(site, `/areas/${area.id}`),
      })),
    ),
  );
}
const shapes = areas
  .filter((entry) => entry.data.outline)
  .map((entry) => ({
    name: entry.data.name,
    href: href(`/areas/${entry.id}`),
    points: entry.data.outline as [number, number][],
  }));
---

<BaseLayout title={pageTitle('Areas')} description={description} image={areasHero.src} imageAlt={areasHero.alt} jsonLd={jsonLd} alternates={[{ lang: 'es', path: '/es/barrios' }]}>
  <div class="wrap">
    <AttributedPhoto picture={areasHero} variant="hero" />
    <header class="page-head">
      <p class="kicker">
        The neighborhood
        <span aria-hidden="true"> · </span>
        <a href={href('/es/barrios')} hreflang="es" lang="es">En español</a>
      </p>
      <h1>Areas</h1>
      <p class="lede">
        Smaller sections of Washington Heights. When one sits inside another, it is listed underneath.
      </p>
      <p class="count">
        {
          areas.length === 0
            ? 'No areas published yet'
            : `${areas.length} ${areas.length === 1 ? 'area' : 'areas'}`
        }
      </p>
    </header>

    {
      shapes.length > 0 && (
        <section class="group" aria-labelledby="map-heading">
          <div class="section-head">
            <h2 id="map-heading">Where each neighborhood is</h2>
          </div>
          <PlaceMap
            pins={[]}
            shapes={shapes}
            tall
            label="Map of the neighborhoods of Washington Heights"
            note="Outlines are approximate: neighborhoods here have no official lines, and neighbors draw them differently. Tap a shape to open it."
          />
        </section>
      )
    }

    {
      areas.length > 0 ? (
        <>
          {nested && (
            <p class="section-note">The number on each area counts places filed there, including smaller sections.</p>
          )}
          <AreaTree nodes={tree} counts={counts} />
          <p class="tag-line">
            <a href={href('/places')}>All places</a>
            <span aria-hidden="true"> · </span>
            <a href={href('/people')}>Notable residents & history</a>
          </p>
        </>
      ) : (
        <p class="empty">
          No areas have been published yet. Smaller sections of the neighborhood will be listed here. When one section sits inside another, it nests under that parent.
        </p>
      )
    }
  </div>
</BaseLayout>
