---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { breadcrumbJsonLd } from '../../lib/jsonld';
import { loadListings } from '../../lib/listings';
import { absoluteUrl, href, pageTitle, siteName } from '../../lib/site';
import { everydayCategories, everydayMapsHref, everydayPlaces } from '../../lib/living-here';
import { categoryInfo } from '../../lib/taxonomy';

/** The everyday categories shown on the building check, nearest first. */
const basicsOrder = ['pharmacy', 'grocery', 'laundry', 'health', 'hardware', 'post'];
const basics = everydayPlaces
  .filter((place) => basicsOrder.includes(place.category))
  .map((place) => ({
    category: place.category,
    kind: everydayCategories.find((item) => item.id === place.category)?.singular ?? place.category,
    name: place.name,
    href: everydayMapsHref(place),
    lat: place.lat,
    lon: place.lon,
  }));

/** Uptown stations from the MTA's station list (data.ny.gov, dataset 39hk-dx4f). ada: the MTA marks the station accessible. */
const stations = [
  { name: '155 St', lines: ['C'], lat: 40.830518, lon: -73.941514, ada: false },
  { name: '155 St', lines: ['B', 'D'], lat: 40.830135, lon: -73.938209, ada: false },
  { name: '157 St', lines: ['1'], lat: 40.834041, lon: -73.94489, ada: false },
  { name: '163 St–Amsterdam Av', lines: ['C'], lat: 40.836013, lon: -73.939892, ada: false },
  { name: '168 St', lines: ['A', 'C'], lat: 40.840719, lon: -73.939561, ada: true },
  { name: '168 St', lines: ['1'], lat: 40.840556, lon: -73.940133, ada: false },
  { name: '175 St', lines: ['A'], lat: 40.847391, lon: -73.939704, ada: true },
  { name: '181 St', lines: ['A'], lat: 40.851695, lon: -73.937969, ada: true },
  { name: '181 St', lines: ['1'], lat: 40.849505, lon: -73.933596, ada: false },
  { name: '190 St', lines: ['A'], lat: 40.859022, lon: -73.93418, ada: false },
  { name: '191 St', lines: ['1'], lat: 40.855225, lon: -73.929412, ada: false },
  { name: 'Dyckman St', lines: ['A'], lat: 40.865491, lon: -73.927271, ada: false },
  { name: 'Dyckman St', lines: ['1'], lat: 40.860531, lon: -73.925536, ada: true },
];

const listings = (await loadListings())
  .filter((listing) => listing.data.latitude != null && listing.data.longitude != null)
  .map((listing) => ({
    name: listing.data.name,
    href: href(`/places/${listing.id}`),
    kind: categoryInfo[listing.data.category].singular,
    lat: listing.data.latitude as number,
    lon: listing.data.longitude as number,
  }));

const site = Astro.site;
if (!site) throw new Error('Missing site URL.');
const description =
  'Check a Washington Heights building before you sign: open housing violations, recent complaints, bedbug filings, HPD registration, the nearest subway, and what is nearby.';
const jsonLd = [
  breadcrumbJsonLd([
    { name: siteName, url: absoluteUrl(site, '/') },
    { name: 'Moving to the Heights', url: absoluteUrl(site, '/moving') },
    { name: 'Check a building', url: absoluteUrl(site, '/moving/building-check') },
  ]),
];
---

<BaseLayout title={pageTitle('Check a building before you sign')} description={description} jsonLd={jsonLd}>
  <article class="wrap moving">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={href('/')}>Home</a>
      <span aria-hidden="true">/</span>
      <a href={href('/moving')}>Moving to the Heights</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Check a building</span>
    </nav>
    <header class="page-head">
      <p class="kicker">Moving here</p>
      <h1>Check a building before you sign</h1>
      <p class="lede">
        Type an address to see the city’s records for the building: open violations, recent complaints, bedbug filings and
        registration, plus the nearest subway and what is nearby.
      </p>
    </header>

    <form class="bc-form" data-bc-form role="search">
      <label for="bc-address" class="bc-label">Building address</label>
      <div class="bc-row">
        <input id="bc-address" name="address" type="text" autocomplete="street-address" placeholder="e.g. 100 Haven Ave" required />
        <button class="button" type="submit">Check</button>
      </div>
      <p class="bc-hint">Street number and name are enough. Built for Washington Heights; other NYC addresses work too.</p>
    </form>

    <p class="bc-status" data-bc-status aria-live="polite"></p>
    <div class="bc-choices" data-bc-choices hidden></div>

    <div class="bc-results" data-bc-results hidden>
      <header class="bc-head">
        <p class="kicker">Results for</p>
        <h2 class="bc-address" data-bc-title></h2>
        <p class="bc-meta" data-bc-meta></p>
        <p class="bc-outside" data-bc-outside hidden>This address is outside Washington Heights. The city records below still apply.</p>
      </header>

      <div class="bc-grid">
        <section class="bc-card" aria-labelledby="bc-violations-h">
          <h3 id="bc-violations-h">Open housing violations</h3>
          <div data-bc="violations"><p class="bc-loading">Loading…</p></div>
        </section>
        <section class="bc-card" aria-labelledby="bc-complaints-h">
          <h3 id="bc-complaints-h">Complaints in the last 12 months</h3>
          <div data-bc="complaints"><p class="bc-loading">Loading…</p></div>
        </section>
        <section class="bc-card" aria-labelledby="bc-bedbugs-h">
          <h3 id="bc-bedbugs-h">Bedbug filings</h3>
          <div data-bc="bedbugs"><p class="bc-loading">Loading…</p></div>
        </section>
        <section class="bc-card" aria-labelledby="bc-registration-h">
          <h3 id="bc-registration-h">Registration and rent</h3>
          <div data-bc="registration"><p class="bc-loading">Loading…</p></div>
        </section>
        <section class="bc-card" aria-labelledby="bc-subway-h">
          <h3 id="bc-subway-h">Nearest subway</h3>
          <div data-bc="subway"></div>
        </section>
        <section class="bc-card" aria-labelledby="bc-basics-h">
          <h3 id="bc-basics-h">Everyday basics</h3>
          <div data-bc="basics"></div>
        </section>
        <section class="bc-card" aria-labelledby="bc-nearby-h">
          <h3 id="bc-nearby-h">Nearby in this guide</h3>
          <div data-bc="nearby"></div>
        </section>
      </div>

      <section class="bc-links" aria-labelledby="bc-links-h">
        <h3 id="bc-links-h">Dig deeper</h3>
        <ul data-bc="links"></ul>
      </section>
    </div>

    <aside class="bc-fineprint">
      <p>
        Records come live from NYC Open Data: HPD housing violations and complaints, bedbug filings, HPD building
        registrations, and the city’s PLUTO building data, with addresses matched by NYC Planning’s GeoSearch. City data can lag
        and can be incomplete. A clean record is not a guarantee, so visit the building, talk to tenants, and read the lease.
      </p>
    </aside>
  </article>
</BaseLayout>

<script is:inline define:vars={{ stations, listings, basics, basicsOrder, livingHref: href('/moving/living-here') }}>
  (() => {
    const form = document.querySelector('[data-bc-form]');
    const input = document.getElementById('bc-address');
    const statusEl = document.querySelector('[data-bc-status]');
    const choicesEl = document.querySelector('[data-bc-choices]');
    const results = document.querySelector('[data-bc-results]');
    const slot = (name) => document.querySelector(`[data-bc="${name}"]`);
    const heightsZips = ['10031', '10032', '10033', '10034', '10040'];
    const socrata = 'https://data.cityofnewyork.us/resource/';

    const esc = (value) =>
      String(value ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
    const fmtDate = (value) =>
      value ? new Date(value.slice(0, 10) + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
    const title = (text) => String(text ?? '').toLowerCase().replace(/\b\w/g, (c) => c.toUpperCase());
    const ext = (url, label) => `<a href="${esc(url)}" rel="noopener noreferrer" target="_blank">${esc(label)}<span class="sr-only"> (opens in a new tab)</span></a>`;
    const query = async (dataset, params) => {
      const url = `${socrata}${dataset}.json?${new URLSearchParams(params)}`;
      const response = await fetch(url);
      if (!response.ok) throw new Error(`${dataset} ${response.status}`);
      return response.json();
    };
    const failed = (name) => {
      slot(name).innerHTML = '<p class="bc-empty">The city’s data service did not respond. Try again in a minute.</p>';
    };

    const meters = (aLat, aLon, bLat, bLon) => {
      const rad = Math.PI / 180;
      const dLat = (bLat - aLat) * rad;
      const dLon = (bLon - aLon) * rad;
      const h = Math.sin(dLat / 2) ** 2 + Math.cos(aLat * rad) * Math.cos(bLat * rad) * Math.sin(dLon / 2) ** 2;
      return 2 * 6371000 * Math.asin(Math.sqrt(h));
    };
    // Straight-line distance times 1.3 for the street grid, at about 80 meters a minute.
    const walk = (m) => `about ${Math.max(1, Math.round((m * 1.3) / 80))} min walk`;

    async function violations(bbl) {
      try {
        const [byClass, serious] = await Promise.all([
          query('wvxf-dwi5', { $select: 'class, count(*) as n', $where: `bbl='${bbl}' AND violationstatus='Open'`, $group: 'class' }),
          query('wvxf-dwi5', {
            $select: 'novdescription, inspectiondate',
            $where: `bbl='${bbl}' AND violationstatus='Open' AND class='C'`,
            $order: 'inspectiondate DESC',
            $limit: '4',
          }),
        ]);
        const counts = { A: 0, B: 0, C: 0 };
        for (const row of byClass) if (row.class in counts) counts[row.class] = Number(row.n);
        const total = counts.A + counts.B + counts.C;
        let html = `<p class="bc-big">${total}</p>`;
        html += `<ul class="bc-classes">
          <li><span class="bc-class bc-class-c">C</span> ${counts.C} immediately hazardous</li>
          <li><span class="bc-class bc-class-b">B</span> ${counts.B} hazardous</li>
          <li><span class="bc-class bc-class-a">A</span> ${counts.A} non-hazardous</li></ul>`;
        if (serious.length) {
          html += '<p class="bc-sub">Most recent class C:</p><ul class="bc-list">';
          html += serious
            .map((row) => {
              // Drop a leading legal citation ("§ 27-2017.1 HMC:") only when a colon closes it; otherwise keep the full text.
              const raw = row.novdescription || '';
              const colon = raw.indexOf(':');
              const text = (raw.trim().startsWith('§') && colon > -1 && colon < 45 ? raw.slice(colon + 1) : raw).trim().toLowerCase();
              const sentence = text.charAt(0).toUpperCase() + text.slice(1);
              return `<li><span class="bc-date">${fmtDate(row.inspectiondate)}</span> ${esc(sentence.length > 160 ? `${sentence.slice(0, 157)}…` : sentence)}</li>`;
            })
            .join('');
          html += '</ul>';
        }
        if (total === 0) html += '<p class="bc-empty">No open violations on record.</p>';
        slot('violations').innerHTML = html;
      } catch {
        failed('violations');
      }
    }

    async function complaints(bbl) {
      try {
        const since = new Date(Date.now() - 365 * 864e5).toISOString().slice(0, 10);
        const rows = await query('ygpa-z7cr', {
          $select: 'major_category, count(*) as n',
          $where: `bbl='${bbl}' AND received_date > '${since}'`,
          $group: 'major_category',
          $order: 'n DESC',
        });
        const total = rows.reduce((sum, row) => sum + Number(row.n), 0);
        let html = `<p class="bc-big">${total}</p><p class="bc-sub">problems reported to HPD since ${fmtDate(since)}</p>`;
        if (rows.length) {
          html += '<ul class="bc-bars">';
          const max = Number(rows[0].n);
          html += rows
            .slice(0, 6)
            .map(
              (row) =>
                `<li><span>${esc(title(row.major_category))}</span><span class="bc-bar" style="--w:${Math.round((Number(row.n) / max) * 100)}%"></span><span>${row.n}</span></li>`,
            )
            .join('');
          html += '</ul>';
        } else {
          html += '<p class="bc-empty">No complaints on record in the last year.</p>';
        }
        slot('complaints').innerHTML = html;
      } catch {
        failed('complaints');
      }
    }

    async function bedbugs(bbl) {
      try {
        const rows = await query('wz6d-d3jb', { $where: `bbl='${bbl}'`, $order: 'filing_date DESC', $limit: '1' });
        if (!rows.length) {
          slot('bedbugs').innerHTML = '<p class="bc-empty">No bedbug filing found for this building.</p>';
          return;
        }
        const row = rows[0];
        const infested = Number(row.infested_dwelling_unit_count || 0);
        slot('bedbugs').innerHTML = `<p class="bc-big">${infested}</p>
          <p class="bc-sub">units reported infested in the owner’s latest annual filing (${fmtDate(row.filing_date)})</p>
          <ul class="bc-list"><li>${esc(row.eradicated_unit_count || 0)} units reported eradicated</li>
          <li>${esc(row.re_infested_dwelling_unit || 0)} units re-infested after treatment</li>
          <li>${esc(row.of_dwelling_units || '?')} units in the building</li></ul>`;
      } catch {
        failed('bedbugs');
      }
    }

    async function registration(boro, block, lot) {
      try {
        const rows = await query('tesw-yqqr', { boroid: boro, block, lot, $order: 'registrationenddate DESC', $limit: '1' });
        const rent = ext('https://rentguidelinesboard.cityofnewyork.us/resources/rent-stabilized-building-lists/', 'Rent Guidelines Board building lists');
        let html = '';
        if (rows.length) {
          const row = rows[0];
          const current = row.registrationenddate && new Date(row.registrationenddate) > new Date();
          html += `<p class="bc-flag ${current ? 'bc-ok' : 'bc-warn'}">${current ? 'Registered with HPD' : 'HPD registration has expired'}</p>`;
          html += `<p class="bc-sub">Last registered ${fmtDate(row.lastregistrationdate)}; ${current ? 'valid until' : 'expired'} ${fmtDate(row.registrationenddate)}.</p>`;
        } else {
          html += '<p class="bc-flag bc-neutral">No HPD registration found</p><p class="bc-sub">Owners of buildings with three or more apartments must register with HPD. Smaller buildings may not appear.</p>';
        }
        html += `<p class="bc-sub">Rent stabilization: the city does not publish a live list. Check the ${rent}, and ask for the apartment’s rent history before you sign.</p>`;
        slot('registration').innerHTML = html;
      } catch {
        failed('registration');
      }
    }

    function subway(lat, lon) {
      const near = stations
        .map((station) => ({ ...station, m: meters(lat, lon, station.lat, station.lon) }))
        .sort((a, b) => a.m - b.m)
        .slice(0, 3);
      slot('subway').innerHTML =
        '<ul class="bc-list">' +
        near
          .map(
            (s) =>
              `<li><span class="moving-lines">${s.lines.map((l) => `<span class="line-bullet ${l === '1' ? 'line-red' : l === 'B' || l === 'D' ? 'line-orange' : 'line-blue'}">${l}</span>`).join('')}</span> <strong>${esc(s.name)}</strong>, ${walk(s.m)}${s.ada ? ' · accessible' : ''}</li>`,
          )
          .join('') +
        `</ul><p class="bc-sub">${ext('https://www.mta.info/elevator-escalator-status', 'Live elevator status')}</p>`;
    }

    function nearby(lat, lon) {
      const near = listings
        .map((place) => ({ ...place, m: meters(lat, lon, place.lat, place.lon) }))
        .filter((place) => place.m < 650)
        .sort((a, b) => a.m - b.m)
        .slice(0, 8);
      slot('nearby').innerHTML = near.length
        ? '<ul class="bc-list">' +
          near.map((p) => `<li><a href="${esc(p.href)}">${esc(p.name)}</a> <span class="bc-date">${esc(p.kind)} · ${walk(p.m)}</span></li>`).join('') +
          '</ul>'
        : '<p class="bc-empty">No places from this guide within a short walk yet.</p>';
    }

    function everyday(lat, lon) {
      const nearest = basicsOrder
        .map((category) =>
          basics
            .filter((place) => place.category === category)
            .map((place) => ({ ...place, m: meters(lat, lon, place.lat, place.lon) }))
            .sort((a, b) => a.m - b.m)[0],
        )
        .filter((place) => place && place.m < 1500);
      slot('basics').innerHTML =
        (nearest.length
          ? '<ul class="bc-list">' +
            nearest
              .map((p) => `<li><span class="bc-date">${esc(p.kind)}</span><br />${ext(p.href, p.name)} <span class="bc-date">· ${walk(p.m)}</span></li>`)
              .join('') +
            '</ul>'
          : '<p class="bc-empty">No everyday places found nearby.</p>') +
        `<p class="bc-sub"><a href="${esc(livingHref)}">All everyday places</a> · Map data © OpenStreetMap contributors</p>`;
    }

    function links(bbl, bin, boro, block, lot, label) {
      const items = [
        [`https://zola.planning.nyc.gov/l/lot/${boro}/${block}/${lot}`, 'Zoning and lot details (NYC Planning ZoLa)'],
        [`https://a810-bisweb.nyc.gov/bisweb/PropertyProfileOverviewServlet?boro=${boro}&block=${block}&lot=${lot}`, 'Permits and building complaints (NYC Buildings)'],
        [`https://hpdonline.nyc.gov/hpdonline/`, 'Full violation history and contacts (HPD Online)'],
        ['https://www.nyc.gov/site/planning/data-maps/flood-hazard-mapper.page', 'Flood risk (NYC Flood Hazard Mapper)'],
        ['https://schoolsearch.schools.nyc/', 'Zoned public schools (NYC Public Schools)'],
      ];
      slot('links').innerHTML = items.map(([url, text]) => `<li>${ext(url, text)}</li>`).join('');
    }

    async function plutoMeta(bbl) {
      try {
        const rows = await query('64uk-42ks', { bbl, $select: 'yearbuilt, numfloors, unitsres', $limit: '1' });
        const row = rows[0];
        if (!row) return '';
        const parts = [];
        if (Number(row.yearbuilt)) parts.push(`Built ${row.yearbuilt}`);
        if (Number(row.numfloors)) parts.push(`${Math.round(Number(row.numfloors))} floors`);
        if (Number(row.unitsres)) parts.push(`${row.unitsres} apartments`);
        return parts.join(' · ');
      } catch {
        return '';
      }
    }

    async function show(feature) {
      const pad = feature.properties.addendum?.pad;
      if (!pad?.bbl) {
        statusEl.textContent = 'That address did not match a tax lot. Try the building’s main street number.';
        return;
      }
      const bbl = pad.bbl;
      const bin = pad.bin;
      const boro = bbl.slice(0, 1);
      const block = String(Number(bbl.slice(1, 6)));
      const lot = String(Number(bbl.slice(6)));
      const [lon, lat] = feature.geometry.coordinates;
      const label = `${title(feature.properties.name)}, ${feature.properties.borough}`;
      const zip = feature.properties.postalcode;

      choicesEl.hidden = true;
      statusEl.textContent = `Showing city records for ${label}.`;
      results.hidden = false;
      document.querySelector('[data-bc-title]').textContent = label;
      document.querySelector('[data-bc-outside]').hidden = heightsZips.includes(zip);
      document.querySelector('[data-bc-meta]').textContent = `Block ${block}, lot ${lot}`;
      for (const name of ['violations', 'complaints', 'bedbugs', 'registration']) slot(name).innerHTML = '<p class="bc-loading">Loading…</p>';

      const url = new URL(location.href);
      url.searchParams.set('address', feature.properties.name);
      history.replaceState(null, '', url);

      subway(lat, lon);
      everyday(lat, lon);
      nearby(lat, lon);
      links(bbl, bin, boro, block, lot, label);
      plutoMeta(bbl).then((meta) => {
        if (meta) document.querySelector('[data-bc-meta]').textContent = `${meta} · Block ${block}, lot ${lot}`;
      });
      await Promise.all([violations(bbl), complaints(bbl), bedbugs(bbl), registration(boro, block, lot)]);
      results.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    async function search(text) {
      statusEl.textContent = 'Looking up the address…';
      results.hidden = true;
      choicesEl.hidden = true;
      try {
        const response = await fetch(`https://geosearch.planninglabs.nyc/v2/search?size=6&text=${encodeURIComponent(text)}`);
        const data = await response.json();
        const features = (data.features || []).filter((f) => f.properties.addendum?.pad?.bbl);
        const manhattanFirst = [...features].sort((a, b) => (b.properties.borough === 'Manhattan') - (a.properties.borough === 'Manhattan'));
        if (!manhattanFirst.length) {
          statusEl.textContent = 'No NYC address matched. Check the spelling, or add the street type (Ave, St).';
          return;
        }
        // Prefer the Manhattan match whose house number is the one typed; GeoSearch scores are often tied.
        const number = (text.match(/^\s*(\d+[A-Za-z]?(?:-\d+)?)\s/) || [])[1];
        const matched = number
          ? manhattanFirst.find((f) => f.properties.borough === 'Manhattan' && f.properties.name.startsWith(`${number.toUpperCase()} `))
          : undefined;
        const onlyOne = manhattanFirst.filter((f) => f.properties.borough === 'Manhattan').length === 1;
        if (matched || onlyOne) {
          await show(matched ?? manhattanFirst[0]);
          return;
        }
        statusEl.textContent = 'More than one address matched. Pick one:';
        choicesEl.innerHTML = manhattanFirst
          .slice(0, 5)
          .map((f, i) => `<button type="button" class="bc-choice" data-i="${i}">${esc(title(f.properties.name))}, ${esc(f.properties.borough)} ${esc(f.properties.postalcode || '')}</button>`)
          .join('');
        choicesEl.hidden = false;
        choicesEl.onclick = (event) => {
          const button = event.target.closest('[data-i]');
          if (button) show(manhattanFirst[Number(button.dataset.i)]);
        };
      } catch {
        statusEl.textContent = 'The address service did not respond. Try again in a minute.';
      }
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const text = input.value.trim();
      if (text) search(/manhattan|new york|ny\b/i.test(text) ? text : `${text}, Manhattan`);
    });

    const initial = new URLSearchParams(location.search).get('address');
    if (initial) {
      input.value = initial;
      search(`${initial}, Manhattan`);
    }
  })();
</script>
