---
import BuildingCheck from '../../components/BuildingCheck.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { breadcrumbJsonLd } from '../../lib/jsonld';
import { absoluteUrl, href, pageTitle, siteName } from '../../lib/site';

const site = Astro.site;
if (!site) throw new Error('Missing site URL.');
const description =
  'Check a Washington Heights building before you sign: open housing violations, recent complaints, bedbug filings, HPD registration, the nearest subway, and what is nearby.';
const jsonLd = [
  breadcrumbJsonLd([
    { name: siteName, url: absoluteUrl(site, '/') },
    { name: 'Moving to the Heights', url: absoluteUrl(site, '/moving') },
    { name: 'Check a building', url: absoluteUrl(site, '/moving/building-check') },
  ]),
];
---

<BaseLayout
  title={pageTitle('Check a building before you sign')}
  description={description}
  jsonLd={jsonLd}
  alternates={[{ lang: 'es', path: '/es/mudarse/revisar-edificio' }]}
>
  <article class="wrap moving">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={href('/')}>Home</a>
      <span aria-hidden="true">/</span>
      <a href={href('/moving')}>Moving to the Heights</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Check a building</span>
    </nav>
    <header class="page-head">
      <p class="kicker">
        Moving here
        <span aria-hidden="true"> · </span>
        <a href={href('/es/mudarse/revisar-edificio')} hreflang="es" lang="es">En español</a>
      </p>
      <h1>Check a building before you sign</h1>
      <p class="lede">
        Type an address to see the city’s records for the building: open violations, recent complaints, bedbug filings and
        registration, plus the nearest subway and what is nearby.
      </p>
    </header>
    <BuildingCheck lang="en" />
  </article>
</BaseLayout>
