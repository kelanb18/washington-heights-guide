---
/**
 * "Check a building before you sign": looks up an address and shows live NYC Open Data for the building.
 * Used by /moving/building-check (English) and /es/mudarse/revisar-edificio (Spanish).
 */
import { loadListings } from '../lib/listings';
import { everydayMapsHref, everydayPlaces } from '../lib/living-here';
import { href } from '../lib/site';
import { categoryInfo } from '../lib/taxonomy';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;

const strings = {
  en: {
    label: 'Building address',
    placeholder: 'e.g. 100 Haven Ave',
    check: 'Check',
    hint: 'Street number and name are enough. Built for Washington Heights; other NYC addresses work too.',
    resultsFor: 'Results for',
    outside: 'This address is outside Washington Heights. The city records below still apply.',
    violations: 'Open housing violations',
    complaints: 'Complaints in the last 12 months',
    bedbugs: 'Bedbug filings',
    registration: 'Registration and rent',
    subway: 'Nearest subway',
    basics: 'Everyday basics',
    nearby: 'Nearby in this guide',
    digDeeper: 'Dig deeper',
    loading: 'Loading…',
    lookingUp: 'Looking up the address…',
    noMatch: 'No NYC address matched. Check the spelling, or add the street type (Ave, St).',
    pickOne: 'More than one address matched. Pick one:',
    noLot: 'That address did not match a tax lot. Try the building’s main street number.',
    showing: 'Showing city records for',
    geoDown: 'The address service did not respond. Try again in a minute.',
    dataDown: 'The city’s data service did not respond. Try again in a minute.',
    classC: 'immediately hazardous',
    classB: 'hazardous',
    classA: 'non-hazardous',
    recentC: 'Most recent class C:',
    noViolations: 'No open violations on record.',
    problemsSince: 'problems reported to HPD since',
    noComplaints: 'No complaints on record in the last year.',
    noBedbugs: 'No bedbug filing found for this building.',
    infested: 'units reported infested in the owner’s latest annual filing',
    eradicated: 'units reported eradicated',
    reinfested: 'units re-infested after treatment',
    unitsInBuilding: 'units in the building',
    registered: 'Registered with HPD',
    expired: 'HPD registration has expired',
    lastRegistered: 'Last registered',
    validUntil: 'valid until',
    expiredOn: 'expired',
    noRegistration: 'No HPD registration found',
    registrationRule: 'Owners of buildings with three or more apartments must register with HPD. Smaller buildings may not appear.',
    rentBefore: 'Rent stabilization: the city does not publish a live list. Check the',
    rentLink: 'Rent Guidelines Board building lists',
    rentAfter: ', and ask for the apartment’s rent history before you sign.',
    accessible: 'accessible',
    elevatorStatus: 'Live elevator status',
    walk: (min: number) => `about ${min} min walk`,
    noBasics: 'No everyday places found nearby.',
    allBasics: 'All everyday places',
    noNearby: 'No places from this guide within a short walk yet.',
    built: 'Built',
    floors: 'floors',
    apartments: 'apartments',
    blockLot: (block: string, lot: string) => `Block ${block}, lot ${lot}`,
    links: [
      'Zoning and lot details (NYC Planning ZoLa)',
      'Permits and building complaints (NYC Buildings)',
      'Full violation history and contacts (HPD Online)',
      'Flood risk (NYC Flood Hazard Mapper)',
      'Zoned public schools (NYC Public Schools)',
    ],
    opensNewTab: '(opens in a new tab)',
    fineprint:
      'Records come live from NYC Open Data: HPD housing violations and complaints, bedbug filings, HPD building registrations, and the city’s PLUTO building data, with addresses matched by NYC Planning’s GeoSearch. Everyday places come from OpenStreetMap. City data can lag and can be incomplete. A clean record is not a guarantee, so visit the building, talk to tenants, and read the lease.',
    dateLocale: 'en-US',
    kinds: { pharmacy: 'Pharmacy', grocery: 'Grocery', laundry: 'Laundry', health: 'Hospital or clinic', hardware: 'Hardware', post: 'Post office' },
    categoryName: (id: string) => categoryInfo[id as keyof typeof categoryInfo]?.singular ?? id,
    livingHref: '/moving/living-here',
  },
  es: {
    label: 'Dirección del edificio',
    placeholder: 'p. ej. 100 Haven Ave',
    check: 'Revisar',
    hint: 'Basta con el número y la calle. Hecho para Washington Heights; también funciona con otras direcciones de NYC.',
    resultsFor: 'Resultados para',
    outside: 'Esta dirección está fuera de Washington Heights. Los registros de la ciudad igual aplican.',
    violations: 'Violaciones de vivienda abiertas',
    complaints: 'Quejas en los últimos 12 meses',
    bedbugs: 'Reportes de chinches',
    registration: 'Registro y renta',
    subway: 'Metro más cercano',
    basics: 'Lo básico cerca',
    nearby: 'Cerca, en esta guía',
    digDeeper: 'Para saber más',
    loading: 'Cargando…',
    lookingUp: 'Buscando la dirección…',
    noMatch: 'Ninguna dirección de NYC coincide. Revisa la ortografía o agrega el tipo de calle (Ave, St).',
    pickOne: 'Coincide más de una dirección. Elige una:',
    noLot: 'Esa dirección no coincide con un lote. Prueba con el número principal del edificio.',
    showing: 'Registros de la ciudad para',
    geoDown: 'El servicio de direcciones no respondió. Inténtalo de nuevo en un minuto.',
    dataDown: 'El servicio de datos de la ciudad no respondió. Inténtalo de nuevo en un minuto.',
    classC: 'peligro inmediato',
    classB: 'peligrosas',
    classA: 'no peligrosas',
    recentC: 'Clase C más recientes:',
    noViolations: 'No hay violaciones abiertas registradas.',
    problemsSince: 'problemas reportados a HPD desde el',
    noComplaints: 'No hay quejas registradas en el último año.',
    noBedbugs: 'No se encontró un reporte de chinches para este edificio.',
    infested: 'unidades con chinches en el último reporte anual del dueño',
    eradicated: 'unidades reportadas como eliminadas',
    reinfested: 'unidades reinfestadas después del tratamiento',
    unitsInBuilding: 'unidades en el edificio',
    registered: 'Registrado con HPD',
    expired: 'El registro con HPD venció',
    lastRegistered: 'Último registro',
    validUntil: 'válido hasta el',
    expiredOn: 'venció el',
    noRegistration: 'No se encontró registro con HPD',
    registrationRule: 'Los dueños de edificios con tres o más apartamentos deben registrarse con HPD. Los edificios más pequeños pueden no aparecer.',
    rentBefore: 'Renta estabilizada: la ciudad no publica una lista en vivo. Revisa las',
    rentLink: 'listas de edificios de la Rent Guidelines Board',
    rentAfter: ' y pide el historial de renta del apartamento antes de firmar.',
    accessible: 'accesible',
    elevatorStatus: 'Estado de los ascensores en vivo',
    walk: (min: number) => `unos ${min} min a pie`,
    noBasics: 'No se encontraron lugares cotidianos cerca.',
    allBasics: 'Todos los lugares cotidianos',
    noNearby: 'Todavía no hay lugares de esta guía a poca distancia.',
    built: 'Construido en',
    floors: 'pisos',
    apartments: 'apartamentos',
    blockLot: (block: string, lot: string) => `Manzana ${block}, lote ${lot}`,
    links: [
      'Zonificación y lote (NYC Planning ZoLa, en inglés)',
      'Permisos y quejas del edificio (NYC Buildings, en inglés)',
      'Historial de violaciones y contactos (HPD Online, en inglés)',
      'Riesgo de inundación (NYC Flood Hazard Mapper, en inglés)',
      'Escuelas públicas por zona (NYC Public Schools)',
    ],
    opensNewTab: '(se abre en una pestaña nueva)',
    fineprint:
      'Los registros vienen en vivo de NYC Open Data: violaciones y quejas de vivienda de HPD, reportes de chinches, registros de edificios de HPD y los datos de edificios PLUTO de la ciudad; las direcciones se buscan con GeoSearch de NYC Planning. Los lugares cotidianos vienen de OpenStreetMap. Los datos de la ciudad pueden atrasarse o estar incompletos. Un historial limpio no es garantía: visita el edificio, habla con los inquilinos y lee el contrato.',
    dateLocale: 'es-US',
    kinds: { pharmacy: 'Farmacia', grocery: 'Supermercado', laundry: 'Lavandería', health: 'Hospital o clínica', hardware: 'Ferretería', post: 'Correo' },
    categoryName: (id: string) =>
      ({ restaurant: 'Restaurante', cafe: 'Café', bakery: 'Panadería', bar: 'Bar', shop: 'Tienda', service: 'Servicio', landmark: 'Lugar de interés' })[id] ?? id,
    livingHref: '/es/mudarse/vivir-aqui',
  },
}[lang];

/** The everyday categories shown on the building check, nearest first. */
const basicsOrder = ['pharmacy', 'grocery', 'laundry', 'health', 'hardware', 'post'];
const basics = everydayPlaces
  .filter((place) => basicsOrder.includes(place.category))
  .map((place) => ({
    category: place.category,
    kind: strings.kinds[place.category as keyof typeof strings.kinds] ?? place.category,
    name: place.name,
    href: everydayMapsHref(place),
    lat: place.lat,
    lon: place.lon,
  }));

/** Uptown stations from the MTA's station list (data.ny.gov, dataset 39hk-dx4f). ada: the MTA marks the station accessible. */
const stations = [
  { name: '155 St', lines: ['C'], lat: 40.830518, lon: -73.941514, ada: false },
  { name: '155 St', lines: ['B', 'D'], lat: 40.830135, lon: -73.938209, ada: false },
  { name: '157 St', lines: ['1'], lat: 40.834041, lon: -73.94489, ada: false },
  { name: '163 St–Amsterdam Av', lines: ['C'], lat: 40.836013, lon: -73.939892, ada: false },
  { name: '168 St', lines: ['A', 'C'], lat: 40.840719, lon: -73.939561, ada: true },
  { name: '168 St', lines: ['1'], lat: 40.840556, lon: -73.940133, ada: false },
  { name: '175 St', lines: ['A'], lat: 40.847391, lon: -73.939704, ada: true },
  { name: '181 St', lines: ['A'], lat: 40.851695, lon: -73.937969, ada: true },
  { name: '181 St', lines: ['1'], lat: 40.849505, lon: -73.933596, ada: false },
  { name: '190 St', lines: ['A'], lat: 40.859022, lon: -73.93418, ada: false },
  { name: '191 St', lines: ['1'], lat: 40.855225, lon: -73.929412, ada: false },
  { name: 'Dyckman St', lines: ['A'], lat: 40.865491, lon: -73.927271, ada: false },
  { name: 'Dyckman St', lines: ['1'], lat: 40.860531, lon: -73.925536, ada: true },
];

const listings = (await loadListings())
  .filter((listing) => listing.data.latitude != null && listing.data.longitude != null)
  .map((listing) => ({
    name: listing.data.name,
    href: href(`/places/${listing.id}`),
    kind: strings.categoryName(listing.data.category),
    lat: listing.data.latitude as number,
    lon: listing.data.longitude as number,
  }));

// Plain strings for the browser script (functions cannot be serialized).
const t = {
  ...Object.fromEntries(Object.entries(strings).filter(([, value]) => typeof value === 'string' || Array.isArray(value))),
  walkTemplate: strings.walk(999),
  blockLotTemplate: strings.blockLot('BLOCK', 'LOT'),
  livingHref: href(strings.livingHref),
};
---

<form class="bc-form" data-bc-form role="search">
  <label for="bc-address" class="bc-label">{strings.label}</label>
  <div class="bc-row">
    <input id="bc-address" name="address" type="text" autocomplete="street-address" placeholder={strings.placeholder} required />
    <button class="button" type="submit">{strings.check}</button>
  </div>
  <p class="bc-hint">{strings.hint}</p>
</form>

<p class="bc-status" data-bc-status aria-live="polite"></p>
<div class="bc-choices" data-bc-choices hidden></div>

<div class="bc-results" data-bc-results hidden>
  <header class="bc-head">
    <p class="kicker">{strings.resultsFor}</p>
    <h2 class="bc-address" data-bc-title></h2>
    <p class="bc-meta" data-bc-meta></p>
    <p class="bc-outside" data-bc-outside hidden>{strings.outside}</p>
  </header>

  <div class="bc-grid">
    <section class="bc-card" aria-labelledby="bc-violations-h">
      <h3 id="bc-violations-h">{strings.violations}</h3>
      <div data-bc="violations"></div>
    </section>
    <section class="bc-card" aria-labelledby="bc-complaints-h">
      <h3 id="bc-complaints-h">{strings.complaints}</h3>
      <div data-bc="complaints"></div>
    </section>
    <section class="bc-card" aria-labelledby="bc-bedbugs-h">
      <h3 id="bc-bedbugs-h">{strings.bedbugs}</h3>
      <div data-bc="bedbugs"></div>
    </section>
    <section class="bc-card" aria-labelledby="bc-registration-h">
      <h3 id="bc-registration-h">{strings.registration}</h3>
      <div data-bc="registration"></div>
    </section>
    <section class="bc-card" aria-labelledby="bc-subway-h">
      <h3 id="bc-subway-h">{strings.subway}</h3>
      <div data-bc="subway"></div>
    </section>
    <section class="bc-card" aria-labelledby="bc-basics-h">
      <h3 id="bc-basics-h">{strings.basics}</h3>
      <div data-bc="basics"></div>
    </section>
    <section class="bc-card" aria-labelledby="bc-nearby-h">
      <h3 id="bc-nearby-h">{strings.nearby}</h3>
      <div data-bc="nearby"></div>
    </section>
  </div>

  <section class="bc-links" aria-labelledby="bc-links-h">
    <h3 id="bc-links-h">{strings.digDeeper}</h3>
    <ul data-bc="links"></ul>
  </section>
</div>

<aside class="bc-fineprint">
  <p>{strings.fineprint}</p>
</aside>

<script is:inline define:vars={{ stations, listings, basics, basicsOrder, t }}>
  (() => {
    const form = document.querySelector('[data-bc-form]');
    const input = document.getElementById('bc-address');
    const statusEl = document.querySelector('[data-bc-status]');
    const choicesEl = document.querySelector('[data-bc-choices]');
    const results = document.querySelector('[data-bc-results]');
    const slot = (name) => document.querySelector(`[data-bc="${name}"]`);
    const heightsZips = ['10031', '10032', '10033', '10034', '10040'];
    const socrata = 'https://data.cityofnewyork.us/resource/';

    const esc = (value) =>
      String(value ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
    const fmtDate = (value) =>
      value ? new Date(value.slice(0, 10) + 'T12:00:00').toLocaleDateString(t.dateLocale, { month: 'short', day: 'numeric', year: 'numeric' }) : '';
    const title = (text) => String(text ?? '').toLowerCase().replace(/\b\w/g, (c) => c.toUpperCase());
    const ext = (url, label) => `<a href="${esc(url)}" rel="noopener noreferrer" target="_blank">${esc(label)}<span class="sr-only"> ${esc(t.opensNewTab)}</span></a>`;
    const loading = `<p class="bc-loading">${esc(t.loading)}</p>`;
    const query = async (dataset, params) => {
      const response = await fetch(`${socrata}${dataset}.json?${new URLSearchParams(params)}`);
      if (!response.ok) throw new Error(`${dataset} ${response.status}`);
      return response.json();
    };
    const failed = (name) => {
      slot(name).innerHTML = `<p class="bc-empty">${esc(t.dataDown)}</p>`;
    };

    const meters = (aLat, aLon, bLat, bLon) => {
      const rad = Math.PI / 180;
      const dLat = (bLat - aLat) * rad;
      const dLon = (bLon - aLon) * rad;
      const h = Math.sin(dLat / 2) ** 2 + Math.cos(aLat * rad) * Math.cos(bLat * rad) * Math.sin(dLon / 2) ** 2;
      return 2 * 6371000 * Math.asin(Math.sqrt(h));
    };
    // Straight-line distance times 1.3 for the street grid, at about 80 meters a minute.
    const walk = (m) => t.walkTemplate.replace('999', String(Math.max(1, Math.round((m * 1.3) / 80))));

    async function violations(bbl) {
      try {
        const [byClass, serious] = await Promise.all([
          query('wvxf-dwi5', { $select: 'class, count(*) as n', $where: `bbl='${bbl}' AND violationstatus='Open'`, $group: 'class' }),
          query('wvxf-dwi5', {
            $select: 'novdescription, inspectiondate',
            $where: `bbl='${bbl}' AND violationstatus='Open' AND class='C'`,
            $order: 'inspectiondate DESC',
            $limit: '4',
          }),
        ]);
        const counts = { A: 0, B: 0, C: 0 };
        for (const row of byClass) if (row.class in counts) counts[row.class] = Number(row.n);
        const total = counts.A + counts.B + counts.C;
        let html = `<p class="bc-big">${total}</p>`;
        html += `<ul class="bc-classes">
          <li><span class="bc-class bc-class-c">C</span> ${counts.C} ${esc(t.classC)}</li>
          <li><span class="bc-class bc-class-b">B</span> ${counts.B} ${esc(t.classB)}</li>
          <li><span class="bc-class bc-class-a">A</span> ${counts.A} ${esc(t.classA)}</li></ul>`;
        if (serious.length) {
          html += `<p class="bc-sub">${esc(t.recentC)}</p><ul class="bc-list">`;
          html += serious
            .map((row) => {
              // Drop a leading legal citation ("§ 27-2017.1 HMC:") only when a colon closes it; otherwise keep the full text.
              const raw = row.novdescription || '';
              const colon = raw.indexOf(':');
              const text = (raw.trim().startsWith('§') && colon > -1 && colon < 45 ? raw.slice(colon + 1) : raw).trim().toLowerCase();
              const sentence = text.charAt(0).toUpperCase() + text.slice(1);
              return `<li><span class="bc-date">${fmtDate(row.inspectiondate)}</span> ${esc(sentence.length > 160 ? `${sentence.slice(0, 157)}…` : sentence)}</li>`;
            })
            .join('');
          html += '</ul>';
        }
        if (total === 0) html += `<p class="bc-empty">${esc(t.noViolations)}</p>`;
        slot('violations').innerHTML = html;
      } catch {
        failed('violations');
      }
    }

    async function complaints(bbl) {
      try {
        const since = new Date(Date.now() - 365 * 864e5).toISOString().slice(0, 10);
        const rows = await query('ygpa-z7cr', {
          $select: 'major_category, count(*) as n',
          $where: `bbl='${bbl}' AND received_date > '${since}'`,
          $group: 'major_category',
          $order: 'n DESC',
        });
        const total = rows.reduce((sum, row) => sum + Number(row.n), 0);
        let html = `<p class="bc-big">${total}</p><p class="bc-sub">${esc(t.problemsSince)} ${fmtDate(since)}</p>`;
        if (rows.length) {
          const max = Number(rows[0].n);
          html +=
            '<ul class="bc-bars">' +
            rows
              .slice(0, 6)
              .map(
                (row) =>
                  `<li><span>${esc(title(row.major_category))}</span><span class="bc-bar" style="--w:${Math.round((Number(row.n) / max) * 100)}%"></span><span>${row.n}</span></li>`,
              )
              .join('') +
            '</ul>';
        } else {
          html += `<p class="bc-empty">${esc(t.noComplaints)}</p>`;
        }
        slot('complaints').innerHTML = html;
      } catch {
        failed('complaints');
      }
    }

    async function bedbugs(bbl) {
      try {
        const rows = await query('wz6d-d3jb', { $where: `bbl='${bbl}'`, $order: 'filing_date DESC', $limit: '1' });
        if (!rows.length) {
          slot('bedbugs').innerHTML = `<p class="bc-empty">${esc(t.noBedbugs)}</p>`;
          return;
        }
        const row = rows[0];
        slot('bedbugs').innerHTML = `<p class="bc-big">${esc(Number(row.infested_dwelling_unit_count || 0))}</p>
          <p class="bc-sub">${esc(t.infested)} (${fmtDate(row.filing_date)})</p>
          <ul class="bc-list"><li>${esc(row.eradicated_unit_count || 0)} ${esc(t.eradicated)}</li>
          <li>${esc(row.re_infested_dwelling_unit || 0)} ${esc(t.reinfested)}</li>
          <li>${esc(row.of_dwelling_units || '?')} ${esc(t.unitsInBuilding)}</li></ul>`;
      } catch {
        failed('bedbugs');
      }
    }

    async function registration(boro, block, lot) {
      try {
        const rows = await query('tesw-yqqr', { boroid: boro, block, lot, $order: 'registrationenddate DESC', $limit: '1' });
        const rent = ext('https://rentguidelinesboard.cityofnewyork.us/resources/rent-stabilized-building-lists/', t.rentLink);
        let html = '';
        if (rows.length) {
          const row = rows[0];
          const current = row.registrationenddate && new Date(row.registrationenddate) > new Date();
          html += `<p class="bc-flag ${current ? 'bc-ok' : 'bc-warn'}">${esc(current ? t.registered : t.expired)}</p>`;
          html += `<p class="bc-sub">${esc(t.lastRegistered)} ${fmtDate(row.lastregistrationdate)}; ${esc(current ? t.validUntil : t.expiredOn)} ${fmtDate(row.registrationenddate)}.</p>`;
        } else {
          html += `<p class="bc-flag bc-neutral">${esc(t.noRegistration)}</p><p class="bc-sub">${esc(t.registrationRule)}</p>`;
        }
        html += `<p class="bc-sub">${esc(t.rentBefore)} ${rent}${esc(t.rentAfter)}</p>`;
        slot('registration').innerHTML = html;
      } catch {
        failed('registration');
      }
    }

    function subway(lat, lon) {
      const near = stations
        .map((station) => ({ ...station, m: meters(lat, lon, station.lat, station.lon) }))
        .sort((a, b) => a.m - b.m)
        .slice(0, 3);
      const color = (l) => (l === '1' ? 'line-red' : l === 'B' || l === 'D' ? 'line-orange' : 'line-blue');
      slot('subway').innerHTML =
        '<ul class="bc-list">' +
        near
          .map(
            (s) =>
              `<li><span class="moving-lines">${s.lines.map((l) => `<span class="line-bullet ${color(l)}">${l}</span>`).join('')}</span> <strong>${esc(s.name)}</strong>, ${esc(walk(s.m))}${s.ada ? ` · ${esc(t.accessible)}` : ''}</li>`,
          )
          .join('') +
        `</ul><p class="bc-sub">${ext('https://www.mta.info/elevator-escalator-status', t.elevatorStatus)}</p>`;
    }

    function everyday(lat, lon) {
      const nearest = basicsOrder
        .map((category) =>
          basics
            .filter((place) => place.category === category)
            .map((place) => ({ ...place, m: meters(lat, lon, place.lat, place.lon) }))
            .sort((a, b) => a.m - b.m)[0],
        )
        .filter((place) => place && place.m < 1500);
      slot('basics').innerHTML =
        (nearest.length
          ? '<ul class="bc-list">' +
            nearest.map((p) => `<li><span class="bc-date">${esc(p.kind)}</span><br />${ext(p.href, p.name)} <span class="bc-date">· ${esc(walk(p.m))}</span></li>`).join('') +
            '</ul>'
          : `<p class="bc-empty">${esc(t.noBasics)}</p>`) +
        `<p class="bc-sub"><a href="${esc(t.livingHref)}">${esc(t.allBasics)}</a> · Map data © OpenStreetMap contributors</p>`;
    }

    function nearby(lat, lon) {
      const near = listings
        .map((place) => ({ ...place, m: meters(lat, lon, place.lat, place.lon) }))
        .filter((place) => place.m < 650)
        .sort((a, b) => a.m - b.m)
        .slice(0, 8);
      slot('nearby').innerHTML = near.length
        ? '<ul class="bc-list">' + near.map((p) => `<li><a href="${esc(p.href)}">${esc(p.name)}</a> <span class="bc-date">${esc(p.kind)} · ${esc(walk(p.m))}</span></li>`).join('') + '</ul>'
        : `<p class="bc-empty">${esc(t.noNearby)}</p>`;
    }

    function links(boro, block, lot) {
      const urls = [
        `https://zola.planning.nyc.gov/l/lot/${boro}/${block}/${lot}`,
        `https://a810-bisweb.nyc.gov/bisweb/PropertyProfileOverviewServlet?boro=${boro}&block=${block}&lot=${lot}`,
        'https://hpdonline.nyc.gov/hpdonline/',
        'https://www.nyc.gov/site/planning/data-maps/flood-hazard-mapper.page',
        'https://schoolsearch.schools.nyc/',
      ];
      slot('links').innerHTML = urls.map((url, i) => `<li>${ext(url, t.links[i])}</li>`).join('');
    }

    async function plutoMeta(bbl) {
      try {
        const rows = await query('64uk-42ks', { bbl, $select: 'yearbuilt, numfloors, unitsres', $limit: '1' });
        const row = rows[0];
        if (!row) return '';
        const parts = [];
        if (Number(row.yearbuilt)) parts.push(`${t.built} ${row.yearbuilt}`);
        if (Number(row.numfloors)) parts.push(`${Math.round(Number(row.numfloors))} ${t.floors}`);
        if (Number(row.unitsres)) parts.push(`${row.unitsres} ${t.apartments}`);
        return parts.join(' · ');
      } catch {
        return '';
      }
    }

    async function show(feature) {
      const pad = feature.properties.addendum?.pad;
      if (!pad?.bbl) {
        statusEl.textContent = t.noLot;
        return;
      }
      const bbl = pad.bbl;
      const boro = bbl.slice(0, 1);
      const block = String(Number(bbl.slice(1, 6)));
      const lot = String(Number(bbl.slice(6)));
      const [lon, lat] = feature.geometry.coordinates;
      const label = `${title(feature.properties.name)}, ${feature.properties.borough}`;
      const blockLot = t.blockLotTemplate.replace('BLOCK', block).replace('LOT', lot);

      choicesEl.hidden = true;
      statusEl.textContent = `${t.showing} ${label}.`;
      results.hidden = false;
      document.querySelector('[data-bc-title]').textContent = label;
      document.querySelector('[data-bc-outside]').hidden = heightsZips.includes(feature.properties.postalcode);
      document.querySelector('[data-bc-meta]').textContent = blockLot;
      for (const name of ['violations', 'complaints', 'bedbugs', 'registration']) slot(name).innerHTML = loading;

      const url = new URL(location.href);
      url.searchParams.set('address', feature.properties.name);
      history.replaceState(null, '', url);

      subway(lat, lon);
      everyday(lat, lon);
      nearby(lat, lon);
      links(boro, block, lot);
      plutoMeta(bbl).then((meta) => {
        if (meta) document.querySelector('[data-bc-meta]').textContent = `${meta} · ${blockLot}`;
      });
      await Promise.all([violations(bbl), complaints(bbl), bedbugs(bbl), registration(boro, block, lot)]);
      results.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    async function search(text) {
      statusEl.textContent = t.lookingUp;
      results.hidden = true;
      choicesEl.hidden = true;
      try {
        const response = await fetch(`https://geosearch.planninglabs.nyc/v2/search?size=6&text=${encodeURIComponent(text)}`);
        const data = await response.json();
        const features = (data.features || []).filter((f) => f.properties.addendum?.pad?.bbl);
        const manhattanFirst = [...features].sort((a, b) => (b.properties.borough === 'Manhattan') - (a.properties.borough === 'Manhattan'));
        if (!manhattanFirst.length) {
          statusEl.textContent = t.noMatch;
          return;
        }
        // Prefer the Manhattan match whose house number is the one typed; GeoSearch scores are often tied.
        const number = (text.match(/^\s*(\d+[A-Za-z]?(?:-\d+)?)\s/) || [])[1];
        const matched = number
          ? manhattanFirst.find((f) => f.properties.borough === 'Manhattan' && f.properties.name.startsWith(`${number.toUpperCase()} `))
          : undefined;
        const onlyOne = manhattanFirst.filter((f) => f.properties.borough === 'Manhattan').length === 1;
        if (matched || onlyOne) {
          await show(matched ?? manhattanFirst[0]);
          return;
        }
        statusEl.textContent = t.pickOne;
        choicesEl.innerHTML = manhattanFirst
          .slice(0, 5)
          .map((f, i) => `<button type="button" class="bc-choice" data-i="${i}">${esc(title(f.properties.name))}, ${esc(f.properties.borough)} ${esc(f.properties.postalcode || '')}</button>`)
          .join('');
        choicesEl.hidden = false;
        choicesEl.onclick = (event) => {
          const button = event.target.closest('[data-i]');
          if (button) show(manhattanFirst[Number(button.dataset.i)]);
        };
      } catch {
        statusEl.textContent = t.geoDown;
      }
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const text = input.value.trim();
      if (text) search(/manhattan|new york|ny\b/i.test(text) ? text : `${text}, Manhattan`);
    });

    const initial = new URLSearchParams(location.search).get('address');
    if (initial) {
      input.value = initial;
      search(`${initial}, Manhattan`);
    }
  })();
</script>
