---
import AttributedPhoto from './AttributedPhoto.astro';
import { loadAreas } from '../lib/areas';
import { findArea } from '../lib/catalog';
import type { Listing } from '../lib/listings';
import { formatDate, href, isoDate } from '../lib/site';
import { categoryInfo, priceInfo } from '../lib/taxonomy';

interface Props {
  listing: Listing;
  index?: number;
  heading?: 'h2' | 'h3';
}

const { listing, index, heading = 'h2' } = Astro.props;
const data = listing.data;
const category = categoryInfo[data.category];
const area = findArea(await loadAreas(), data.area);
const Heading = heading;
---

<li class:list={['entry', { numbered: index != null, 'has-photo': Boolean(data.image) }]}>
  {index != null && <p class="entry-index">{String(index).padStart(2, '0')}</p>}
  {data.image && <AttributedPhoto picture={data.image} variant="thumb" />}
  <div>
    {
      data.sponsored && (
        <p class="sponsored-flag">
          Sponsored <span class="sr-only">placement</span>
        </p>
      )
    }
    <p class="kicker">
      <a href={href(`/category/${data.category}`)}>{category.singular}</a>
      {
        data.priceLevel && (
          <>
            <span aria-hidden="true"> · </span>
            <span>
              <span class="sr-only">Price: {priceInfo[data.priceLevel]}. </span>
              {data.priceLevel}
            </span>
          </>
        )
      }
      {
        data.pick && (
          <>
            <span aria-hidden="true"> · </span>
            <span>Editor’s pick</span>
          </>
        )
      }
      {
        data.rating != null && (
          <>
            <span aria-hidden="true"> · </span>
            <span>
              <span class="sr-only">Editorial rating </span>
              {data.rating} / 5
            </span>
          </>
        )
      }
    </p>
    <Heading class="entry-title">
      <a href={href(`/places/${listing.id}`)}>{data.name}</a>
    </Heading>
    <p class="verdict">{data.verdict}</p>
    <p class="where">
      {data.crossStreets}
      {
        area && (
          <>
            <span aria-hidden="true"> · </span>
            <a href={href(`/areas/${area.id}`)}>{area.data.name}</a>
          </>
        )
      }
      <span aria-hidden="true"> · </span>
      <time datetime={isoDate(data.lastVerified)}>Checked {formatDate(data.lastVerified)}</time>
    </p>
  </div>
</li>
