---
import { Image } from 'astro:assets';
import type { CreditedImage } from '../lib/picture-schema';
import { resolvePicture } from '../lib/pictures';

interface Props {
  picture: CreditedImage;
  variant?: 'hero' | 'thumb' | 'gallery';
}

const { picture, variant = 'hero' } = Astro.props;
const resolved = resolvePicture(picture.src);
const sizes =
  variant === 'thumb'
    ? '5.5rem'
    : variant === 'gallery'
      ? '(min-width: 720px) 18rem, 100vw'
      : '(min-width: 880px) 50rem, 100vw';
const widths = variant === 'thumb' ? [160, 320] : variant === 'gallery' ? [480, 800] : [640, 960, 1400];
// Heroes sit at the top of the page, so they load right away; everything else loads as it nears the screen.
const loading = variant === 'hero' ? 'eager' : 'lazy';
const fetchpriority = variant === 'hero' ? 'high' : undefined;
---

<figure class:list={['photo', `photo-${variant}`]}>
  {
    resolved.kind === 'asset' ? (
      <Image
        src={resolved.image}
        alt={picture.alt}
        widths={widths}
        sizes={sizes}
        loading={loading}
        fetchpriority={fetchpriority}
        decoding="async"
      />
    ) : resolved.kind === 'remote' ? (
      <Image
        src={resolved.src}
        alt={picture.alt}
        inferSize
        widths={widths}
        sizes={sizes}
        loading={loading}
        fetchpriority={fetchpriority}
        decoding="async"
      />
    ) : (
      <img
        src={resolved.src}
        alt={picture.alt}
        width={picture.width}
        height={picture.height}
        loading={loading}
        fetchpriority={fetchpriority}
        decoding="async"
      />
    )
  }
  <figcaption class="photo-credit">
    <a href={picture.sourceUrl} rel="noopener noreferrer" target="_blank">
      {picture.credit}
      <span class="sr-only"> (opens in a new tab)</span>
    </a>
    <span aria-hidden="true"> · </span>
    {
      picture.licenseUrl ? (
        <a href={picture.licenseUrl} rel="noopener noreferrer" target="_blank">
          {picture.license}
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
      ) : (
        <span>{picture.license}</span>
      )
    }
  </figcaption>
</figure>
