---
import AttributedPhoto from './AttributedPhoto.astro';
import { findArea } from '../lib/catalog';
import { connectionInfo } from '../lib/connections';
import { loadAreas } from '../lib/areas';
import type { Person } from '../lib/people';
import type { CreditedImage } from '../lib/picture-schema';
import { href } from '../lib/site';

interface Props {
  person: Person;
  photo?: CreditedImage | null;
  heading?: 'h2' | 'h3';
}

const { person, photo: photoOverride, heading = 'h2' } = Astro.props;
const data = person.data;
const photo = photoOverride === undefined ? data.image : photoOverride;
const connection = connectionInfo[data.connection];
const area = findArea(await loadAreas(), data.area);
const Heading = heading;
---

<li class:list={['entry', { 'has-photo': Boolean(photo) }]}>
  {photo && <AttributedPhoto picture={photo} variant="thumb" />}
  <div>
    <p class="kicker">
      <a href={`${href('/people')}#${data.connection}`}>{connection.label}</a>
      {
        data.years && (
          <>
            <span aria-hidden="true"> · </span>
            <span>{data.years}</span>
          </>
        )
      }
    </p>
    <Heading class="entry-title">
      <a href={href(`/people/${person.id}`)}>{data.name}</a>
    </Heading>
    <p class="verdict">{data.summary}</p>
    {
      (data.place || area) && (
        <p class="where">
          {data.place}
          {data.place && area && <span aria-hidden="true"> · </span>}
          {area && <a href={href(`/areas/${area.id}`)}>{area.data.name}</a>}
        </p>
      )
    }
  </div>
</li>
