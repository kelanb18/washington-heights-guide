---
import { correctionsEmail, href, scopeLine, siteName } from '../lib/site';
import { categoryPluralEs } from '../lib/spanish';
import { categories, categoryInfo } from '../lib/taxonomy';

interface Props {
  lang?: 'en' | 'es';
  switchPath?: string;
}
const { lang = 'en', switchPath = lang === 'es' ? '/' : '/es' } = Astro.props;
const es = lang === 'es';
const t = es
  ? {
      scope: 'Una guía del barrio de Washington Heights, de la calle 155 oeste hasta el borde de Inwood en Dyckman.',
      about: 'Acerca de',
      disclosure: 'Enlaces de afiliados y patrocinios',
      corrections: 'Correcciones',
      business: 'Para negocios',
      other: 'In English',
      privacy: 'Privacidad',
      correctionsLabel: 'Correcciones',
      kicker: 'Boletín',
      heading: 'La guía del barrio por correo',
      email: 'Correo electrónico',
      placeholder: 'tu@ejemplo.com',
      subscribe: 'Suscribirme',
      note: 'Al suscribirte, aceptas recibir el boletín. Puedes darte de baja cuando quieras. Lee nuestra',
      privacyLink: 'política de privacidad',
      englishNote: 'Las categorías, Acerca de, Para negocios y Privacidad están en inglés por ahora.',
    }
  : null;

const buttondownUsername = 'washingtonheightsguide';
---

<footer class="colophon" data-pagefind-ignore>
  <div class="wrap footer-grid">
    <div>
      <p class="wordmark">{siteName}</p>
      <p>{t ? t.scope : `A neighborhood guide to ${scopeLine}`}</p>
      <p class="footer-categories">
        {categories.map((category, index) => (
          <>
            {index > 0 && <span aria-hidden="true"> · </span>}
            <a href={href(`/category/${category}`)} hreflang={es ? 'en' : undefined}>{es ? categoryPluralEs[category] : categoryInfo[category].plural}</a>
          </>
        ))}
      </p>
      <p>
        <a href={href('/about')} hreflang={es ? 'en' : undefined}>{t ? t.about : 'About'}</a>
        <span aria-hidden="true"> · </span>
        <a href={`${href('/about')}#disclosure`} hreflang={es ? 'en' : undefined}>{t ? t.disclosure : 'Affiliate links and sponsorships'}</a>
        <span aria-hidden="true"> · </span>
        <a href={`${href('/about')}#corrections`} hreflang={es ? 'en' : undefined}>{t ? t.corrections : 'Corrections'}</a>
        <span aria-hidden="true"> · </span>
        <a href={href('/for-businesses')} hreflang={es ? 'en' : undefined}>{t ? t.business : 'For businesses'}</a>
        <span aria-hidden="true"> · </span>
        <a href={href(switchPath)} hreflang={es ? 'en' : 'es'} lang={es ? 'en' : 'es'}>{t ? t.other : 'En español'}</a>
        <span aria-hidden="true"> · </span>
        <a href={href('/privacy')} hreflang={es ? 'en' : undefined}>{t ? t.privacy : 'Privacy'}</a>
      </p>
      {t && <p class="footer-lang-note">{t.englishNote}</p>}
      <p>
        {t ? t.correctionsLabel : 'Corrections'}: <a href={`mailto:${correctionsEmail}`}>{correctionsEmail}</a>
      </p>
    </div>
    <section class="newsletter" aria-labelledby="newsletter-title">
      <p class="kicker">{t ? t.kicker : 'Newsletter'}</p>
      <h2 id="newsletter-title">{t ? t.heading : 'The neighborhood guide by email'}</h2>
      {
        buttondownUsername ? (
          <form
            action={`https://buttondown.com/api/emails/embed-subscribe/${encodeURIComponent(buttondownUsername)}`}
            method="post"
          >
            <label class="sr-only" for="newsletter-email">{t ? t.email : 'Email address'}</label>
            <input
              id="newsletter-email"
              type="email"
              name="email"
              placeholder={t ? t.placeholder : 'you@example.com'}
              autocomplete="email"
              required
            />
            <input type="hidden" name="embed" value="1" />
            <button type="submit" class="button">{t ? t.subscribe : 'Subscribe'}</button>
            <p class="newsletter-note">
              {t ? t.note : 'By subscribing, you agree to receive the newsletter. Unsubscribe anytime. See our'}{' '}
              <a href={href('/privacy')} hreflang={es ? 'en' : undefined}>{t ? t.privacyLink : 'privacy policy'}</a>.
            </p>
          </form>
        ) : (
          <p>Signup is being connected and is not active yet.</p>
        )
      }
    </section>
  </div>
</footer>
