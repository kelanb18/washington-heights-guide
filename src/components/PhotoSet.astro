---
import AttributedPhoto from './AttributedPhoto.astro';
import PhotoPlaceholder from './PhotoPlaceholder.astro';
import type { CreditedImage } from '../lib/picture-schema';

interface Props {
  image?: CreditedImage;
  gallery?: CreditedImage[];
  /** Shown when there is no photograph, so the page does not open on an empty box. */
  mark?: string;
  tone?: string;
  markLabel?: string;
  /** Area photograph used when this page has no photo of its own. */
  borrowed?: { picture: CreditedImage; placeName: string };
}

const { image, gallery = [], mark, tone, markLabel, borrowed } = Astro.props;
---

{
  image ? (
    <AttributedPhoto picture={image} variant="hero" />
  ) : borrowed ? (
    <AttributedPhoto
      picture={borrowed.picture}
      variant="hero"
      note={`Photograph of ${borrowed.placeName}. This place has no photo of its own.`}
    />
  ) : (
    mark && <PhotoPlaceholder name={mark} tone={tone} label={markLabel} variant="hero" />
  )
}
{
  gallery.length > 0 && (
    <div class="photo-gallery">
      {gallery.map((picture) => (
        <AttributedPhoto picture={picture} variant="gallery" />
      ))}
    </div>
  )
}
