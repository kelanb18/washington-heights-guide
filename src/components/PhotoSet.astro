---
import AttributedPhoto from './AttributedPhoto.astro';
import { claimPicture } from '../lib/pictures';
import type { CreditedImage } from '../lib/picture-schema';

interface Props {
  image?: CreditedImage;
  gallery?: CreditedImage[];
}

const { image, gallery = [] } = Astro.props;
const usedPictures = new Set<string>();
const hero = image && claimPicture(image, usedPictures) ? image : undefined;
const uniqueGallery = gallery.filter((picture) => claimPicture(picture, usedPictures));
---

{hero && <AttributedPhoto picture={hero} variant="hero" />}
{
  uniqueGallery.length > 0 && (
    <div class="photo-gallery">
      {uniqueGallery.map((picture) => (
        <AttributedPhoto picture={picture} variant="gallery" />
      ))}
    </div>
  )
}
