---
import PlaceMap from './PlaceMap.astro';
import { loadFilmPermits } from '../lib/film-permits';
import { sightings } from '../lib/sightings';
import { areaChoices, mergeShoots, pinsForShoots, renderTimeline, sourceChoices } from '../lib/shoot-timeline';

const permits = await loadFilmPermits();
const groups = mergeShoots(permits, sightings);
const timeline = renderTimeline(groups);
const sources = sourceChoices(sightings);
const areas = areaChoices(sightings);
const pins = pinsForShoots([...groups.upcoming, ...groups.recent]);
---

<section class="group" id="shoots" aria-labelledby="shoots-heading">
  <div class="section-head">
    <h2 id="shoots-heading">Film shoots near you</h2>
    <a href="https://data.cityofnewyork.us/City-Government/Film-Permits/tg4x-b46p">NYC Open Data</a>
  </div>
  <p class="section-note">
    Resident reports and press reports, merged with city film permits. A report is labeled Confirmed when a news story or a same-day permit covers the block, and Resident-reported when it is a neighbor’s post. City permits name the kind of work and the streets where parking is held. They do not name the production. Reports at the guide’s southern boundary, about West 155th to 158th Street, stay on the list and are marked South edge.
  </p>
  <div class="shoot-filters">
    <div role="group" aria-label="Filter by source">
      {
        sources.map((choice) => (
          <button type="button" data-shoot-source={choice.value} aria-pressed={choice.value === 'all' ? 'true' : 'false'}>
            {choice.label}
          </button>
        ))
      }
    </div>
    <label>
      Area
      <select id="shoot-area">
        {areas.map((choice) => <option value={choice.value}>{choice.label}</option>)}
      </select>
    </label>
  </div>
  <PlaceMap
    pins={pins}
    label="Resident-reported shoots with a known cross street"
    note="Pins are resident reports whose cross streets match a corner saved on this site. The map does not look up new addresses."
  />
  <div id="shoot-board">
    {
      permits.error && (
        <p class="section-note" data-shoot-error>
          {permits.error} This page will try the public feed again in your browser. Resident reports below do not depend on that feed.
        </p>
      )
    }
    <div id="shoot-timeline" set:html={timeline} />
  </div>
  <div class="shoot-tip">
    <p class="kicker">Spotted a shoot?</p>
    <p>Tell us the cross streets, the date, and a link to what you saw. Sending a tip is not connected yet.</p>
    <button type="button" class="shoot-soon" disabled>Coming soon</button>
  </div>
  <p class="section-note">
    Upcoming items are listed first. Resident reports go back to 2023. City permits cover the last four months and anything still on the calendar, and the page asks the dataset again when it loads.
  </p>
</section>

<script>
  import { loadFilmPermits } from '../lib/film-permits';
  import { sightings } from '../lib/sightings';
  import { mergeShoots, renderTimeline } from '../lib/shoot-timeline';

  const timeline = document.getElementById('shoot-timeline');
  const areaSelect = document.getElementById('shoot-area');
  const sourceButtons = document.querySelectorAll<HTMLButtonElement>('[data-shoot-source]');
  if (timeline) {
    let source = 'all';
    let area = 'all';

    const apply = () => {
      const items = timeline.querySelectorAll<HTMLElement>('[data-shoot]');
      let upcoming = 0;
      let recent = 0;
      items.forEach((item) => {
        const sourceOk = source === 'all' || item.dataset.source === source;
        const itemArea = item.dataset.area ?? '';
        const areaOk =
          area === 'all' ||
          (area === 'south-edge' && item.dataset.edge === '1') ||
          (area === 'unspecified' && itemArea === '') ||
          itemArea === area;
        const show = sourceOk && areaOk;
        item.hidden = !show;
        if (!show) return;
        if (item.dataset.bucket === 'upcoming') upcoming += 1;
        else recent += 1;
      });
      timeline.querySelectorAll<HTMLElement>('[data-shoot-group]').forEach((group) => {
        const count = group.dataset.shootGroup === 'upcoming' ? upcoming : recent;
        group.hidden = count === 0;
      });
      let empty = timeline.querySelector<HTMLElement>('[data-filter-empty]');
      if (upcoming === 0 && recent === 0) {
        if (!empty) {
          empty = document.createElement('p');
          empty.className = 'empty';
          empty.dataset.filterEmpty = 'true';
          empty.textContent = 'Nothing in this filter.';
          timeline.append(empty);
        }
      } else {
        empty?.remove();
      }
    };

    sourceButtons.forEach((button) => {
      button.addEventListener('click', () => {
        source = button.dataset.shootSource ?? 'all';
        sourceButtons.forEach((other) => other.setAttribute('aria-pressed', other === button ? 'true' : 'false'));
        apply();
      });
    });
    areaSelect?.addEventListener('change', () => {
      if (areaSelect instanceof HTMLSelectElement) area = areaSelect.value;
      apply();
    });

    void loadFilmPermits()
      .then((result) => {
        if (result.error) {
          if (!timeline.parentElement?.querySelector('[data-shoot-error]') && timeline.querySelector('[data-shoot]')) {
            const note = document.createElement('p');
            note.className = 'section-note';
            note.textContent = 'Could not refresh the permit list. Showing the copy from the last time this site was built.';
            timeline.before(note);
          }
          return;
        }
        timeline.innerHTML = renderTimeline(mergeShoots(result, sightings));
        apply();
      })
      .catch(() => {
        if (timeline.querySelector('[data-shoot]')) {
          const note = document.createElement('p');
          note.className = 'section-note';
          note.textContent = 'Could not refresh the permit list. Showing the copy from the last time this site was built.';
          timeline.before(note);
        }
      });
  }
</script>
