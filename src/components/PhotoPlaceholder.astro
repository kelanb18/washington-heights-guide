---
interface Props {
  name: string;
  tone?: string;
  label?: string;
  variant?: 'thumb' | 'hero';
}

const { name, tone = 'other', label, variant = 'thumb' } = Astro.props;

const skip = new Set(['the', 'a', 'an', 'of', 'and', 'in', 'on', 'at', 'for']);
const words = name
  .replace(/&/g, ' ')
  .split(/[^A-Za-z0-9]+/)
  .filter((word) => word.length > 0 && !skip.has(word.toLowerCase()));
const initials =
  words.length === 0
    ? '?'
    : words.length === 1
      ? words[0].slice(0, 2).toUpperCase()
      : `${words[0][0]}${words[words.length - 1][0]}`.toUpperCase();
---

<div class:list={['mark', `mark-${variant}`]} data-tone={tone} aria-hidden="true">
  <span class="mark-initials">{initials}</span>
  {variant === 'hero' && label && <span class="mark-kind">{label}</span>}
</div>
