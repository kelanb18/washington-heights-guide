---
import { categories, categoryInfo } from '../lib/taxonomy';
import { href, normalizePath } from '../lib/site';

const current = normalizePath(Astro.url.pathname);

function currentAttr(path: string): true | undefined {
  const item = normalizePath(path);
  if (item === '/') return current === '/' ? true : undefined;
  if (current === item || current.startsWith(`${item}/`)) return true;
  return undefined;
}

const primary = [
  { href: href('/best'), label: 'Best of' },
  { href: href('/places'), label: 'Places' },
  { href: href('/areas'), label: 'Areas' },
  { href: href('/people'), label: 'People' },
  { href: href('/filmed-here'), label: 'Filmed here' },
  { href: href('/about'), label: 'About' },
];
---

<header class="masthead" data-pagefind-ignore>
  <div class="wrap">
    <div class="masthead-bar">
      <a class="wordmark" href={href('/')}>The Heights</a>
      <div class="masthead-tools">
        <a class="tool-link" href={href('/search')}>Search</a>
        <button class="tool-link" type="button" id="theme-toggle" aria-pressed="false">Dark mode</button>
      </div>
    </div>
    <nav aria-label="Primary">
      <ul class="nav-list">
        {
          primary.map((item) => (
            <li>
              <a href={item.href} aria-current={currentAttr(item.href) && 'page'}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="flag-rule" aria-hidden="true"></div>
    <nav class="sections" aria-label="Categories">
      <ul>
        {
          categories.map((category) => {
            const path = href(`/category/${category}`);
            return (
              <li>
                <a href={path} aria-current={currentAttr(path) && 'page'}>
                  {categoryInfo[category].plural}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  const toggle = document.getElementById('theme-toggle');
  const sync = () => {
    const dark = document.documentElement.dataset.theme === 'dark';
    if (!toggle) return;
    toggle.textContent = dark ? 'Light mode' : 'Dark mode';
    toggle.setAttribute('aria-pressed', dark ? 'true' : 'false');
  };
  sync();
  toggle?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* ignore */
    }
    sync();
  });
</script>
